<Window x:Class="ReelsConverterUI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ReelsConverterUI.Services"
        Title="Video Editor" Width="940" Height="620"
        Icon="Icons/Editor.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Premium Timeline Slider Style -->
        <!-- Premium Timeline Slider Style -->
        <Style x:Key="PremiumTimelineSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <!-- Track background capsule -->
                            <Border x:Name="TrackBackground" Height="18" CornerRadius="9" Background="#1EFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Grid>
                                    <!-- Highlight range (liquid glow) -->
                                    <Canvas HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                        <Rectangle x:Name="PART_SelectionRange" Height="18" RadiusX="9" RadiusY="9" Fill="#907A9EC0" Visibility="Collapsed"/>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- Solid White rounded progress pill as in pic2 -->
                                                <Border Background="#FFFFFFFF" Height="18" CornerRadius="9"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- Invisible thumb with wide hit-test target (Width=24) -->
                                    <Thumb x:Name="Thumb" Width="24" Height="18" Focusable="False" Cursor="Hand" Margin="-12,0,-12,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Completely thumbless look as in pic2 -->
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Selection range visibility -->
                            <Trigger Property="IsSelectionRangeEnabled" Value="True">
                                <Setter TargetName="PART_SelectionRange" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Hover state: subtle brightness change -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Volume Slider Style -->
        <Style x:Key="PremiumVolumeSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <!-- Track background capsule -->
                            <Border x:Name="TrackBackground" Height="18" CornerRadius="9" Background="#1EFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>

                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- Solid White progress pill -->
                                                <Border Background="#FFFFFFFF" Height="18" CornerRadius="9"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- Invisible thumb with wide hit-test target (Width=24) -->
                                    <Thumb x:Name="Thumb" Width="24" Height="18" Focusable="False" Cursor="Hand" Margin="-12,0,-12,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover state: subtle brightness change -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Glass Icon Button -->
        <Style x:Key="CircularGlassIconBtn" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}" Stroke="#20FFFFFF" StrokeThickness="0.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ TITLE BAR ═══════════ -->
            <Border Grid.Row="0" Background="{DynamicResource BgDeep}" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="✂" FontSize="12" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource EditorTitle}" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <!-- Premium Beta Badge -->
                        <Border Background="#12FFFFFF" BorderBrush="{DynamicResource Accent}" BorderThickness="1" 
                                CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource ErrorRed}"
                            Width="30" Height="30"
                            Click="Close_Click">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>
            <!-- ═══════════ MAIN FCP LAYOUT ═══════════ -->
            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══════ TOP HALF: PREVIEW & INSPECTOR ═══════ -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: VIDEO PREVIEW -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                        <Grid x:Name="PlayerGrid">
                            <!-- Video player background slot -->
                            <Border Background="{DynamicResource BgElevated}" CornerRadius="16" helpers:ClipHelper.CornerRadiusClip="True">
                                <Grid>
                                    <TextBlock x:Name="TxtNoVideo"
                                               Text="{DynamicResource EditorNoVideo}"
                                               Foreground="{DynamicResource TextSec}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <MediaElement x:Name="VideoPlayer"
                                                  LoadedBehavior="Manual" UnloadedBehavior="Close"
                                                  ScrubbingEnabled="True" Stretch="Uniform"
                                                  MediaOpened="VideoPlayer_MediaOpened"
                                                  MediaEnded="VideoPlayer_MediaEnded"
                                                  SizeChanged="VideoPlayer_SizeChanged"/>
                                </Grid>
                            </Border>

                            <!-- Center-aligned crop overlay guide lines -->
                            <Border x:Name="CropOverlay" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.6" ShadowDepth="0"/>
                                </Border.Effect>
                                <!-- Grid representing Rule of Thirds -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Horizontal dashed lines -->
                                    <Line Grid.Row="0" Grid.ColumnSpan="3" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#50FFFFFF" StrokeThickness="1" StrokeDashArray="3,3" VerticalAlignment="Bottom"/>
                                    <Line Grid.Row="1" Grid.ColumnSpan="3" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#50FFFFFF" StrokeThickness="1" StrokeDashArray="3,3" VerticalAlignment="Bottom"/>
                                    
                                    <!-- Vertical dashed lines -->
                                    <Line Grid.RowSpan="3" Grid.Column="0" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" Stroke="#50FFFFFF" StrokeThickness="1" StrokeDashArray="3,3" HorizontalAlignment="Right"/>
                                    <Line Grid.RowSpan="3" Grid.Column="1" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" Stroke="#50FFFFFF" StrokeThickness="1" StrokeDashArray="3,3" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Floating HUD Playbar (Compact Circular Apple style) -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="12,8" CornerRadius="20" Background="#C2121215" BorderBrush="#26FFFFFF" BorderThickness="0.8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Play/Pause/Stop/Mute Buttons -->
                                    <Button x:Name="BtnPlay" Style="{StaticResource CircularGlassIconBtn}" Width="32" Height="32" IsEnabled="False" Click="Play_Click">
                                        <TextBlock x:Name="TxtPlayIcon" Text="▶" FontSize="10.5" Foreground="{DynamicResource TextPrimary}"/>
                                    </Button>
                                    <Button x:Name="BtnStop" Style="{StaticResource CircularGlassIconBtn}" Width="32" Height="32" IsEnabled="False" Margin="6,0,0,0" Click="Stop_Click">
                                        <TextBlock Text="⏹" FontSize="10.5" Foreground="{DynamicResource TextPrimary}"/>
                                    </Button>
                                    <Button x:Name="BtnMuteToggle" Style="{StaticResource CircularGlassIconBtn}" Width="32" Height="32" IsEnabled="False" Margin="6,0,0,0" Click="MuteToggle_Click">
                                        <TextBlock x:Name="TxtMuteIcon" Text="🔊" FontSize="10.5" Foreground="{DynamicResource TextPrimary}"/>
                                    </Button>
                                    
                                    <Separator Width="0.5" Height="16" Background="#30FFFFFF" Margin="10,0" VerticalAlignment="Center"/>
                                    
                                    <!-- Status Badges -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="0.5" CornerRadius="6" Padding="5,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSpeedBadge" Text="1.0x" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                    <Border x:Name="BdVolumeBadge" Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="0.5" CornerRadius="6" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtVolumeBadge" Text="100%" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT: TABBED INSPECTOR -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Segmented Tab Header -->
                            <Border Grid.Row="0" Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0.5" CornerRadius="10" Padding="2" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TabVideo" Grid.Column="0" Style="{StaticResource SegmentedBtn}" Content="🎥" IsChecked="True" GroupName="InspectorTabs" Checked="InspectorTab_Checked"/>
                                    <RadioButton x:Name="TabAudio" Grid.Column="1" Style="{StaticResource SegmentedBtn}" Content="🔊" GroupName="InspectorTabs" Checked="InspectorTab_Checked"/>
                                    <RadioButton x:Name="TabSubs" Grid.Column="2" Style="{StaticResource SegmentedBtn}" Content="💬" GroupName="InspectorTabs" Checked="InspectorTab_Checked"/>
                                    <RadioButton x:Name="TabExport" Grid.Column="3" Style="{StaticResource SegmentedBtn}" Content="📤" GroupName="InspectorTabs" Checked="InspectorTab_Checked"/>
                                </Grid>
                            </Border>

                            <!-- Tab Views Content Slot -->
                            <Grid Grid.Row="1">
                                <!-- 🎥 VIDEO VIEW -->
                                <Border x:Name="InspectorVideo" Visibility="Visible" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource EditorVideoTransformHeader}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,0,4,10"/>
                                        <!-- CROP & ASPECT RATIO -->
                                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource EditorCropSection}"/>
                                                <Border Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0.5" CornerRadius="12" Padding="2" Margin="0,6,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="RadCropOriginal" Grid.Column="0" Style="{StaticResource SegmentedBtn}" Content="{DynamicResource EditorCropOriginal}" IsChecked="True" GroupName="CropRatio" Click="CropRatio_Click" IsEnabled="False"/>
                                                        <RadioButton x:Name="RadCrop916" Grid.Column="1" Style="{StaticResource SegmentedBtn}" Content="9:16" GroupName="CropRatio" Click="CropRatio_Click" IsEnabled="False"/>
                                                        <RadioButton x:Name="RadCrop169" Grid.Column="2" Style="{StaticResource SegmentedBtn}" Content="16:9" GroupName="CropRatio" Click="CropRatio_Click" IsEnabled="False"/>
                                                        <RadioButton x:Name="RadCrop11" Grid.Column="3" Style="{StaticResource SegmentedBtn}" Content="1:1" GroupName="CropRatio" Click="CropRatio_Click" IsEnabled="False"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- TRANSFORM -->
                                        <Border Style="{StaticResource Card}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource EditorTransformSection}"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnRotateCCW" Grid.Column="0" Style="{StaticResource OutlineBtn}" FontSize="10" Padding="4,6" IsEnabled="False" Content="{DynamicResource EditorRotateCCW}" Click="RotateCCW_Click"/>
                                                    <Button x:Name="BtnRotateCW" Grid.Column="2" Style="{StaticResource OutlineBtn}" FontSize="10" Padding="4,6" IsEnabled="False" Content="{DynamicResource EditorRotateCW}" Click="RotateCW_Click"/>
                                                    <Button x:Name="BtnFlipH" Grid.Column="4" Style="{StaticResource OutlineBtn}" FontSize="10" Padding="4,6" IsEnabled="False" Content="{DynamicResource EditorFlipH}" Click="FlipH_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 🔊 AUDIO & SPEED VIEW -->
                                <Border x:Name="InspectorAudio" Visibility="Collapsed" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource EditorAudioRetimingHeader}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,0,4,10"/>
                                        <!-- SPEED & AUDIO -->
                                        <Border Style="{StaticResource Card}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource EditorSpeedAudioSection}"/>
                                                <!-- Playback Speed (Segmented) -->
                                                <TextBlock Text="{DynamicResource EditorPlaybackSpeed}" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="0,8,0,4"/>
                                                <Border Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0.5" CornerRadius="12" Padding="2" Margin="0,0,0,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="RadSpeed05" Grid.Column="0" Style="{StaticResource SegmentedBtn}" Content="0.5x" GroupName="PlaybackSpeed" Click="Speed_Click" IsEnabled="False"/>
                                                        <RadioButton x:Name="RadSpeed10" Grid.Column="1" Style="{StaticResource SegmentedBtn}" Content="1.0x" IsChecked="True" GroupName="PlaybackSpeed" Click="Speed_Click" IsEnabled="False"/>
                                                        <RadioButton x:Name="RadSpeed15" Grid.Column="2" Style="{StaticResource SegmentedBtn}" Content="1.5x" GroupName="PlaybackSpeed" Click="Speed_Click" IsEnabled="False"/>
                                                        <RadioButton x:Name="RadSpeed20" Grid.Column="3" Style="{StaticResource SegmentedBtn}" Content="2.0x" GroupName="PlaybackSpeed" Click="Speed_Click" IsEnabled="False"/>
                                                    </Grid>
                                                </Border>
                                                
                                                <!-- Audio Volume Boost (Slider) -->
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{DynamicResource EditorVolumeBoost}" FontSize="10" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtVolumeVal" Grid.Column="1" Text="100%" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Slider x:Name="SliderVolume" Minimum="0" Maximum="2" Value="1" IsEnabled="False" Margin="0,8,0,0" Style="{StaticResource PremiumVolumeSlider}" ValueChanged="SliderVolume_ValueChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 💬 CAPTIONS VIEW -->
                                <Border x:Name="InspectorSubs" Visibility="Collapsed" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource EditorCaptionsHeader}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,0,4,10"/>
                                        <!-- SUBTITLES -->
                                        <Border Style="{StaticResource Card}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource EditorSubtitleSection}"/>
                                                <Grid Margin="0,8,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{DynamicResource EditorSubModel}" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="0,0,0,4"/>
                                                        <ComboBox x:Name="CmbSubModel" SelectedIndex="1" FontSize="11">
                                                            <ComboBoxItem Content="tiny" Tag="tiny"/>
                                                            <ComboBoxItem Content="base" Tag="base"/>
                                                            <ComboBoxItem Content="small" Tag="small"/>
                                                            <ComboBoxItem Content="medium" Tag="medium"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{DynamicResource EditorSubLang}" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="0,0,0,4"/>
                                                        <ComboBox x:Name="CmbSubLang" SelectedIndex="0" FontSize="11">
                                                            <ComboBoxItem Content="Auto" Tag="auto"/>
                                                            <ComboBoxItem Content="Deutsch" Tag="de"/>
                                                            <ComboBoxItem Content="English" Tag="en"/>
                                                            <ComboBoxItem Content="Español" Tag="es"/>
                                                            <ComboBoxItem Content="Français" Tag="fr"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <Button x:Name="BtnGenSubs" Style="{StaticResource OutlineBtn}" Content="{DynamicResource EditorGenSubs}" IsEnabled="False" Margin="0,6,0,0" Click="GenSubs_Click"/>
                                                <ProgressBar x:Name="PbSubs" Height="2" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="Transparent"/>
                                                <TextBlock x:Name="TxtSubStatus" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="0,4,0,0" Visibility="Collapsed"/>
                                                <TextBox x:Name="TxtSubPreview" FontSize="10" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
                                                <CheckBox x:Name="ChkBurnSubs" IsEnabled="False" Margin="0,8,0,0" Content="{DynamicResource EditorBurnSubs}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 📤 EXPORT VIEW -->
                                <Border x:Name="InspectorExport" Visibility="Collapsed" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource EditorExportMediaHeader}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,0,4,10"/>
                                        <!-- FILE INFO -->
                                        <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtFileName" Grid.Column="0" Text="{DynamicResource EditorNoFileLoaded}" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnBrowseVideo" Grid.Column="1" Style="{StaticResource OutlineBtn}" FontSize="10" Padding="10,4" Content="{DynamicResource EditorBrowse}" Click="BrowseVideo_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- EXPORT OPTIONS -->
                                        <Border Style="{StaticResource Card}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource EditorExportSection}"/>
                                                <Grid Margin="0,8,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{DynamicResource EditorResolution}" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="0,0,0,4"/>
                                                        <ComboBox x:Name="CmbResolution" SelectedIndex="0" FontSize="11" IsEnabled="False">
                                                            <ComboBoxItem Content="{DynamicResource EditorResOriginal}" Tag="original"/>
                                                            <ComboBoxItem Content="{DynamicResource EditorRes1080p}" Tag="1080p"/>
                                                            <ComboBoxItem Content="{DynamicResource EditorRes720p}" Tag="720p"/>
                                                            <ComboBoxItem Content="{DynamicResource EditorRes480p}" Tag="480p"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{DynamicResource EditorFormat}" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="0,0,0,4"/>
                                                        <ComboBox x:Name="CmbFormat" SelectedIndex="0" FontSize="11" IsEnabled="False">
                                                            <ComboBoxItem Content="{DynamicResource EditorFormatMp4}" Tag="mp4"/>
                                                            <ComboBoxItem Content="{DynamicResource EditorFormatMkv}" Tag="mkv"/>
                                                            <ComboBoxItem Content="{DynamicResource EditorFormatWebm}" Tag="webm"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <Button x:Name="BtnExport" Style="{StaticResource GradRectBtn}" Height="36" IsEnabled="False" Content="{DynamicResource EditorExport}" Click="Export_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════ BOTTOM HALF: TIMELINE & TRIM CONSOLE ═══════ -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Height="86">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Timeline Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCurrentTime" Grid.Column="0"
                                       Text="0:00" FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <Slider x:Name="SliderTimeline" Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="0"
                                    IsEnabled="False"
                                    IsSelectionRangeEnabled="True"
                                    Style="{StaticResource PremiumTimelineSlider}"
                                    ValueChanged="SliderTimeline_ValueChanged"
                                    PreviewMouseLeftButtonDown="SliderTimeline_DragStarted"
                                    PreviewMouseLeftButtonUp="SliderTimeline_DragCompleted"/>
                            <TextBlock x:Name="TxtDuration" Grid.Column="2"
                                       Text="0:00" FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,4,0"/>
                        </Grid>
                        
                        <!-- Trim Controls Row -->
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <!-- Left: Section Title -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎞" FontSize="12" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource EditorTimelineHeader}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Center: Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource EditorStartLabel}" FontSize="10" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtTrimStart" Text="0:00" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="BtnSetStart" Style="{StaticResource OutlineBtn}"
                                        FontSize="10" Padding="12,5" IsEnabled="False"
                                        Content="{DynamicResource EditorMarkStart}"
                                        Click="SetStart_Click"/>
                                
                                <TextBlock Text="{DynamicResource EditorEndLabel}" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="12,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTrimEnd" Text="0:00" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="BtnSetEnd" Style="{StaticResource OutlineBtn}"
                                        FontSize="10" Padding="12,5" IsEnabled="False"
                                        Content="{DynamicResource EditorMarkEnd}"
                                        Click="SetEnd_Click"/>
                                
                                <Button x:Name="BtnResetTrim" Style="{StaticResource OutlineBtn}"
                                        FontSize="10" Padding="12,5" Margin="12,0,0,0"
                                        IsEnabled="False"
                                        Content="{DynamicResource EditorResetTrim}"
                                        Click="ResetTrim_Click"/>
                                
                                <CheckBox x:Name="ChkMuteAudio" IsEnabled="False"
                                          Margin="16,0,0,0" VerticalAlignment="Center"
                                          Content="{DynamicResource EditorMuteAudio}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="22" Height="22" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    ToolTip="Drag to resize window"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style quarter-circle resize indicator -->
                <Viewbox>
                    <Grid Width="24" Height="24">
                <!-- Concave arc: opens toward window interior (iPadOS corner grip) -->
                <Path Data="M 0,22 A 22,22 0 0,0 22,0"
                      Stroke="{DynamicResource TextSec}"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.6"
                      Fill="Transparent"/>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</Window>


