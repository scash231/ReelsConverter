<Window x:Class="ReelsConverterUI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortschritt" Width="420"
        SizeToContent="Height"
        Icon="Icons/ProgressWindow.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="#25FFFFFF" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WinScale"/>
                <TranslateTransform x:Name="WinTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <TextBlock Text="Fortschritt" FontWeight="SemiBold"
                               FontSize="12" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button x:Name="BtnCloseWindow" HorizontalAlignment="Right"
                            Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource TextSec}"
                            Width="30" Height="30" Margin="0,2,4,0"
                            ToolTip="Schließen (Läuft im Hintergrund weiter)"
                            Click="CloseWindow_Click">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Progress content -->
            <StackPanel Grid.Row="1" Margin="16,12,16,0">
                <Grid x:Name="RowMsgPct" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtProgressMsg"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtProgressPct" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Border x:Name="ProgressTrack" Height="6" CornerRadius="3"
                        Background="#15FFFFFF">
                    <Border x:Name="ProgressFill" CornerRadius="3"
                            HorizontalAlignment="Left" Width="0"
                            Background="{DynamicResource Accent}"/>
                </Border>

                <Grid x:Name="RowDetail" Margin="0,6,0,0">
                    <TextBlock x:Name="TxtEta" FontSize="11"
                               Foreground="{DynamicResource TextSec}"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtProgressDetail"
                               Foreground="{DynamicResource TextSec}"
                               TextTrimming="CharacterEllipsis"
                               Margin="55,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Footer row: countdown + open folder + console toggle + button -->
            <Grid Grid.Row="2" Margin="16,8,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtCountdown" FontSize="11"
                           Foreground="{DynamicResource TextSec}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <Button x:Name="BtnOpenFolder" Grid.Column="1"
                        Content="📂 Open Folder" Style="{StaticResource OutlineBtn}"
                        Margin="0,0,6,0"
                        Visibility="Collapsed"
                        Click="OpenFolder_Click"/>
                <Button x:Name="BtnToggleLog" Grid.Column="2"
                        Content="▾ Log" Style="{StaticResource OutlineBtn}"
                        Margin="0,0,6,0"
                        Click="ToggleLog_Click"/>
                <Button x:Name="BtnCancel" Grid.Column="3"
                        Content="Abbrechen" Style="{StaticResource OutlineBtn}"
                        Click="Cancel_Click"/>
            </Grid>

            <!-- Console (toggleable) -->
            <TextBox x:Name="TxtConsole" Grid.Row="3"
                     Margin="16,0,16,12"
                     Background="#A80D0E12"
                     BorderBrush="#15FFFFFF" BorderThickness="1"
                     Foreground="{DynamicResource Accent}"
                     FontFamily="Consolas"
                     FontSize="10"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MaxHeight="140"
                     Padding="8,6"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Visibility="Collapsed"/>
            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="22" Height="22" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    ToolTip="Drag to resize window"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style quarter-circle resize indicator -->
                <Viewbox>
                    <Grid Width="24" Height="24">
                <!-- Concave arc: opens toward window interior (iPadOS corner grip) -->
                <Path Data="M 0,22 A 22,22 0 0,0 22,0"
                      Stroke="{DynamicResource TextSec}"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.6"
                      Fill="Transparent"/>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</Window>
