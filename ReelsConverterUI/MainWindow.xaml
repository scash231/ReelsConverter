<Window x:Class="ReelsConverterUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:ReelsConverterUI.Animations"
        xmlns:helpers="clr-namespace:ReelsConverterUI.Services"
        Title="ReelsConverter" Width="760" Height="560"
        MinWidth="600" MinHeight="480"
        Icon="Icons/app.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <!-- ═══════════════════ WINDOW RESOURCES ═══════════════════ -->
    <Window.Resources>
        <Storyboard x:Key="FadeInWindow">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.85" To="1" Duration="0:0:0.52"
                             BeginTime="0:0:0.035">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInWindow}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- ═══════════════════ ROOT BORDER ═══════════════════ -->
    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgGrad}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Dev Console -->
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="Transparent"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Version -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="VideoConverter" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text=" 26H2 Beta" FontSize="9"
                                   Foreground="{DynamicResource TextSec}"
                                   VerticalAlignment="Center" Margin="4,1,0,0"/>
                    </StackPanel>

                    <!-- Middle: Liquid Glass Miniature Progress Bar (Stretches to Right Buttons) -->
                    <Border x:Name="MiniProgressContainer" Grid.Column="1"
                            Height="9" CornerRadius="4.5"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource InputBg}"
                            BorderBrush="{DynamicResource BorderSub}"
                            BorderThickness="0.5"
                            Margin="16,0,14,0" VerticalAlignment="Center"
                            Cursor="Hand" Visibility="Collapsed"
                            MouseLeftButtonDown="MiniProgress_Click"
                            SizeChanged="MiniProgressContainer_SizeChanged"
                            ToolTip="Export-Fortschritt (Klicken für Log &amp; Details)">
                        <Border.Effect>
                            <DropShadowEffect x:Name="MiniProgressGlow" BlurRadius="4" ShadowDepth="0" Color="#FFFFFF" Opacity="0.15"/>
                        </Border.Effect>
                        <Border.Resources>
                            <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="MiniProgressGlow"
                                                 Storyboard.TargetProperty="BlurRadius"
                                                 From="2" To="8" Duration="0:0:1.2"/>
                                <DoubleAnimation Storyboard.TargetName="MiniProgressGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.1" To="0.35" Duration="0:0:1.2"/>
                            </Storyboard>
                        </Border.Resources>
                        <Grid>
                            <!-- Inner Glass Track Depth Groove -->
                            <Border CornerRadius="4" Background="#15000000"/>
                            
                            <!-- Liquid Glass Grey Fill Bar -->
                            <Border x:Name="MiniProgressFill" Height="9" CornerRadius="4"
                                    Width="0" HorizontalAlignment="Left" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#4A4E5A" Offset="0"/>
                                        <GradientStop Color="#6E7485" Offset="0.5"/>
                                        <GradientStop Color="#5A5F6E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <!-- Glass Specular Top Gloss Highlight -->
                                    <Border Height="4.5" VerticalAlignment="Top" CornerRadius="4,4,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#55FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Inner Subtle Sheen Overlay -->
                                    <Border Height="1" VerticalAlignment="Bottom" Margin="1,0,1,1" CornerRadius="0,0,3,3" Background="#20FFFFFF"/>
                                </Grid>
                            </Border>
                            
                            <!-- Capsule Glass Refraction Sheen Overlay for Entire Container -->
                            <Border CornerRadius="4.5" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center">

                        <!-- Pill 1: ! and ? -->
                        <Border Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource BorderSub}"
                                BorderThickness="0.5" CornerRadius="8"
                                Padding="4.7,0" Margin="0,0,4,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Error Status Button + divider (collapsed as a group) -->
                                <Button x:Name="BtnErrorStatus"
                                        Style="{StaticResource IconBtn}"
                                        Foreground="{DynamicResource ErrorRed}"
                                        Width="30.1" Height="30.1" Margin="0"
                                        ToolTip="Error Details"
                                        Visibility="Collapsed"
                                        Click="ErrorStatus_Click">
                                    <TextBlock Text="!" FontSize="17.3" FontWeight="Bold"/>
                                </Button>
                                <!-- Divider after ! (collapsed with it) -->
                                <Border x:Name="ErrorPillDivider"
                                        Width="1" Height="11.5"
                                        Background="{DynamicResource BorderSub}"
                                        Margin="2,0" Visibility="Collapsed"
                                        VerticalAlignment="Center"/>
                                <!-- Help / Workflow -->
                                <Button x:Name="BtnHelp"
                                        Style="{StaticResource IconBtn}"
                                        Foreground="{DynamicResource TextSec}"
                                        Width="30.1" Height="30.1" Margin="0"
                                        ToolTip="Workflow"
                                        Click="Help_Click">
                                    <TextBlock Text="?" FontSize="15.0" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Pill 2: 🎨, ✂, ⚙ -->
                        <Border Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource BorderSub}"
                                BorderThickness="0.5" CornerRadius="8"
                                Padding="4.7,0" Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Theme Designer -->
                                <Button Style="{StaticResource IconBtn}"
                                        Foreground="{DynamicResource TextSec}"
                                        Width="30.1" Height="30.1" Margin="0"
                                        ToolTip="{DynamicResource TipDesigner}"
                                        Click="Designer_Click">
                                    <TextBlock Text="🎨" FontSize="13.9"/>
                                </Button>
                                <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="2,0" VerticalAlignment="Center"/>
                                <!-- Video Editor -->
                                <Button Style="{StaticResource IconBtn}"
                                        Foreground="{DynamicResource TextSec}"
                                        Width="30.1" Height="30.1" Margin="0"
                                        ToolTip="{DynamicResource TipEditor}"
                                        Click="Editor_Click">
                                    <TextBlock Text="✂" FontSize="13.9"/>
                                </Button>
                                <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="2,0" VerticalAlignment="Center"/>
                                <!-- Settings -->
                                <Button Style="{StaticResource IconBtn}"
                                        Foreground="{DynamicResource TextSec}"
                                        Width="30.1" Height="30.1" Margin="0"
                                        ToolTip="{DynamicResource TipSettings}"
                                        Click="Settings_Click">
                                    <TextBlock Text="⚙" FontSize="16.2"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Language Toggle Pill Button -->
                        <Button x:Name="BtnLangPill" VerticalAlignment="Center" Margin="0,0,6,0"
                                Click="LangPill_Click" Style="{StaticResource IconBtn}"
                                ToolTip="Select Language" Padding="0">
                            <Border Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource BorderSub}"
                                    BorderThickness="0.5" CornerRadius="8"
                                    Height="30.1" Padding="9.2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCurrentLang" Text="DE"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center"/>
                                    <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLangArrow" Text="&gt;&gt;"
                                               FontSize="13.9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSec}"
                                               VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource IconBtn}"
                                Foreground="{DynamicResource TextSec}" Width="34.8" Height="34.8"
                                Click="Minimize_Click">
                            <TextBlock Text="─" FontSize="13.9"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}"
                                Foreground="{DynamicResource ErrorRed}" Width="34.8" Height="34.8"
                                Click="Close_Click">
                            <TextBlock Text="✕" FontSize="12.7"/>
                        </Button>
                    </StackPanel>
                    <Popup x:Name="HelpPopup"
                           Placement="Bottom"
                           VerticalOffset="4"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="None">
                        <Border x:Name="HelpPopupBorder"
                                Background="#D5202024"
                                BorderBrush="#557A9EC0" BorderThickness="1"
                                anim:FluidMotion.CornerRadiusValue="55"
                                Padding="14,12" MinWidth="200"
                                Opacity="0" RenderTransformOrigin="0.5,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="2" Color="#7A9EC0" Opacity="0.25"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    <TranslateTransform Y="-4"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <StackPanel>
                                <TextBlock Text="Workflow" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSec}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="①" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" Width="18"/>
                                    <TextBlock Text="{DynamicResource Step1}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="②" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" Width="18"/>
                                    <TextBlock Text="{DynamicResource Step2}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="③" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" Width="18"/>
                                    <TextBlock Text="{DynamicResource Step3}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="ErrorPopup"
                           Placement="Bottom"
                           VerticalOffset="4"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="None">
                        <Border x:Name="ErrorPopupBorder"
                                Background="#D5202024"
                                BorderBrush="#55C44848" BorderThickness="1"
                                anim:FluidMotion.CornerRadiusValue="55"
                                Padding="14,12" Width="320"
                                Opacity="0" RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    <TranslateTransform Y="-4"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="2" Color="#C44848" Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚠" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource ErrorRed}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource ErrPopupTitle}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ErrorRed}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtPopupErrorDetails" FontSize="10.5"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="14"/>
                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource ErrPopupFix}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSec}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtPopupErrorFix" FontSize="10"
                                           Foreground="{DynamicResource TextSec}" TextWrapping="Wrap" LineHeight="13.5" Margin="0,0,0,12"/>
                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnCopyErrorDetails" Grid.Column="0"
                                            Style="{StaticResource GlassPillBtn}"
                                            Margin="0,0,4,0" Height="24"
                                            Click="CopyErrorDetails_Click"
                                            ToolTip="{DynamicResource ErrPopupCopy}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource ErrPopupCopy}" FontSize="9.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnShowLogs" Grid.Column="1"
                                            Style="{StaticResource GlassPillBtn}"
                                            Margin="4,0,0,0" Height="24"
                                            Click="ShowLogs_Click"
                                            ToolTip="{DynamicResource ErrPopupConsole}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💻" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource ErrPopupConsole}" FontSize="9.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Button x:Name="BtnRestartBackend"
                                        Style="{StaticResource GlassPillBtn}"
                                        Margin="0,8,0,0" Height="24"
                                        Click="RestartBackend_Click"
                                        Visibility="Collapsed"
                                        ToolTip="{DynamicResource ErrPopupRestart}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource ErrPopupRestart}" FontSize="9.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ═══════════ MAIN CONTENT ═══════════ -->
            <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="14,6,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ──── URL BAR (full-width) ──── -->
				<!-- ──── UNIFIED FULL-WIDTH URL INPUT CAPSULE ──── -->
				<Border Grid.Row="0" Height="51" Margin="0,0,0,8" CornerRadius="50"
				        Background="{DynamicResource InputBg}"
				        BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
				        Padding="2,0,2,0">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<!-- 1. URL Text Input (Clips cleanly at column edge) -->
						<TextBox x:Name="TxtUrl" Grid.Column="0" VerticalAlignment="Center"
						         Background="Transparent" BorderThickness="0"
						         Foreground="{DynamicResource TextPrimary}"
						         CaretBrush="{DynamicResource Accent}"
						         Padding="14,0,8,0" FontSize="12"
						         Tag="{DynamicResource UrlPlaceholder}"
						         TextChanged="TxtUrl_TextChanged">
							<TextBox.Style>
								<Style TargetType="TextBox">
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="TextBox">
												<Grid>
													<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
													<TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
													           Foreground="{DynamicResource TextSec}" Opacity="0.6"
													           FontSize="{TemplateBinding FontSize}"
													           VerticalAlignment="Center" IsHitTestVisible="False"
													           Margin="14,0,8,0"
													           Visibility="Collapsed"/>
												</Grid>
												<ControlTemplate.Triggers>
													<Trigger Property="Text" Value="">
														<Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</TextBox.Style>
						</TextBox>

						<!-- 2. Vertical Separator Line 1 -->
						<Border Grid.Column="1" Width="1" VerticalAlignment="Stretch" Margin="2,8"
						        Background="{DynamicResource BorderSub}" Opacity="0.6"/>

						<!-- 3. Paste Button -->
						<Button Grid.Column="2" ToolTip="{DynamicResource TipPaste}"
						        Style="{StaticResource EmbeddedCapsuleBtn}"
						        Padding="10,4" Margin="2,3" VerticalAlignment="Stretch"
						        Click="Paste_Click">
							<TextBlock Text="📋" FontSize="13.5" Opacity="0.85" VerticalAlignment="Center" HorizontalAlignment="Center"/>
						</Button>

						<!-- 4. Vertical Separator Line 2 -->
						<Border Grid.Column="3" Width="1" VerticalAlignment="Stretch" Margin="2,8"
						        Background="{DynamicResource BorderSub}" Opacity="0.6"/>

						<!-- 5. Metadata Button -->
						<Button Grid.Column="4" x:Name="BtnFetch"
						        Content="{DynamicResource BtnFetch}"
						        Style="{StaticResource EmbeddedCapsuleBtn}"
						        Foreground="{DynamicResource TextSec}"
						        FontSize="11.5" FontWeight="SemiBold"
						        Padding="12,4" Margin="2,3,4,3" VerticalAlignment="Stretch"
						        Click="Fetch_Click"/>
					</Grid>
				</Border>
				
				<!-- ──── MODE TOGGLE (iOS 26 segmented control) ──── -->
                <Border x:Name="SegmentTrack" Grid.Row="1" CornerRadius="50" Padding="3"
                        Background="{DynamicResource InputBg}"
                        BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                        Margin="0,0,0,8" Cursor="Hand"
                        PreviewMouseLeftButtonDown="Segment_PreviewMouseDown"
                        PreviewMouseMove="Segment_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Segment_PreviewMouseUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Animated pill indicator -->
                        <Border x:Name="SegmentIndicator" Grid.Column="0"
                                CornerRadius="50" Background="{DynamicResource ActiveBg}"
                                BorderBrush="Transparent" BorderThickness="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SegmentScale"/>
                                    <TranslateTransform x:Name="SegmentTranslateX"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <RadioButton x:Name="RbUpload" Style="{StaticResource SegmentedBtn}"
                                     GroupName="Mode" IsChecked="True"
                                     Checked="Mode_Changed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⬆" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource ModeUploadTitle}"
                                           FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" x:Name="RbDownload"
                                     Style="{StaticResource SegmentedBtn}"
                                     GroupName="Mode" Checked="Mode_Changed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⬇" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource ModeDownloadTitle}"
                                           FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- ──── Two-column layout ──── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ LEFT: Preview ═══ -->
                    <Grid Grid.Column="0">
                        <Border x:Name="BorderMeta" Style="{StaticResource Card}"
                                Visibility="Collapsed" Opacity="0" Padding="0"
                                helpers:ClipHelper.CornerRadiusClip="True"
                                ClipToBounds="True" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <!-- Thumbnail -->
                                    <Border x:Name="ThumbBgBorder" CornerRadius="16,16,0,0"
                                            helpers:ClipHelper.CornerRadiusClip="True"
                                            Background="{DynamicResource ThumbGrad}"
                                            ClipToBounds="True" MaxHeight="200">
                                        <Grid>
                                            <TextBlock x:Name="TxtMetaThumbFallback" Text="🎥"
                                                       FontSize="36" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image x:Name="ImgThumbnail" Stretch="UniformToFill"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <!-- 10% darken overlay -->
                                            <Border Background="#1A000000"/>
                                            <!-- YouTube Music Liquid Glass Badge Pill -->
                                            <Border x:Name="BorderYTMusicBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="10" Padding="10,4.5" CornerRadius="50"
                                                    Background="#4514151B"
                                                    BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.8"
                                                    Visibility="Collapsed">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.35"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <!-- Glass top specular highlight overlay -->
                                                    <Border Height="10" VerticalAlignment="Top" CornerRadius="50,50,0,0" IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource PlatformYTMusic}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- Info -->
                                    <StackPanel Margin="12,8,12,4">
                                        <TextBlock x:Name="TxtMetaTitle" FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" MaxHeight="32"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TxtMetaUploader" FontSize="10"
                                                       Foreground="{DynamicResource TextPrimary}" Opacity="0.75"/>
                                            <TextBlock x:Name="TxtMetaAlbum" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}" Opacity="0.9"
                                                       Margin="6,0,0,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="TxtMetaDuration" FontSize="10"
                                                       Foreground="{DynamicResource TextPrimary}" Opacity="0.75"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ItemsControl x:Name="TagsList" Margin="0,5,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="7" Padding="6,2"
                                                            Margin="0,0,3,3"
                                                            Background="{DynamicResource InputBg}">
                                                        <TextBlock Text="{Binding}" FontSize="9"
                                                                   Foreground="{DynamicResource Accent}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
 
                                <!-- Quick actions (integrated card footer) -->
                                <Border Grid.Row="1"
                                        BorderBrush="{DynamicResource BorderSub}"
                                        BorderThickness="0,0.5,0,0" Padding="8,5">
                                    <DockPanel>
                                        <Button Style="{StaticResource IconBtn}" DockPanel.Dock="Right"
                                                Click="ClearForm_Click" Padding="4,3"
                                                ToolTip="{DynamicResource TipClearForm}">
                                            <TextBlock Text="✕" FontSize="10"
                                                       Foreground="{DynamicResource TextSec}"/>
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconBtn}" Padding="4,3"
                                                    Click="CopyTitle_Click" ToolTip="Copy title">
                                                <TextBlock Text="📝" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconBtn}" Padding="4,3"
                                                    Margin="1,0,0,0"
                                                    Click="CopyUrl_Click" ToolTip="Copy URL">
                                                <TextBlock Text="🔗" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconBtn}" Padding="4,3"
                                                    Margin="1,0,0,0"
                                                    Click="OpenInBrowser_Click"
                                                    ToolTip="Open in browser">
                                                <TextBlock Text="🌐" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconBtn}" Padding="4,3"
                                                    Margin="1,0,0,0"
                                                    Click="SaveThumbnail_Click"
                                                    ToolTip="Save thumbnail">
                                                <TextBlock Text="💾" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
 
                    <!-- ═══ RIGHT: Settings ═══ -->
                    <StackPanel Grid.Column="2">
 
                        <!-- UPLOAD SETTINGS -->
                        <Border x:Name="BorderUpload" Style="{StaticResource Card}"
                                Visibility="Collapsed" Opacity="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblTitleField}" FontSize="10"
                                           Foreground="{DynamicResource TextSec}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtTitle"/>
                                <Grid Margin="0,8,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource LblDescField}" FontSize="10"
                                               Foreground="{DynamicResource TextSec}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}"
                                            ToolTip="{DynamicResource TipEditDesc}"
                                            Click="EditDescription_Click">
                                        <TextBlock Text="✏" FontSize="12"
                                                   Foreground="{DynamicResource TextSec}"/>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="TxtDescription" IsReadOnly="True"
                                         TextWrapping="Wrap" Height="120"
                                         BorderBrush="{DynamicResource BorderSub}"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="{DynamicResource TipDescBox}"
                                         MouseDoubleClick="EditDescription_Click"/>
                                <TextBlock Text="{DynamicResource LblVisibility}" FontSize="10"
                                           Foreground="{DynamicResource TextSec}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="CmbPrivacy" SelectedIndex="0">
                                    <ComboBoxItem Content="{DynamicResource PrivacyPublic}"   Tag="public"/>
                                    <ComboBoxItem Content="{DynamicResource PrivacyUnlisted}" Tag="unlisted"/>
                                    <ComboBoxItem Content="{DynamicResource PrivacyPrivate}"  Tag="private"/>
                                </ComboBox>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkFingerprint" Style="{StaticResource SubtleToggleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblFingerprint" Text="Fingerprint" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ChkFingerprint}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbFingerprintMethod" Grid.Column="1"
                                              Margin="8,0,0,0" SelectedIndex="2"
                                              IsEnabled="{Binding IsChecked, ElementName=ChkFingerprint}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBoxItem Content="{DynamicResource FpMetadata}" Tag="metadata"/>
                                        <ComboBoxItem Content="{DynamicResource FpLight}"    Tag="light"/>
                                        <ComboBoxItem Content="{DynamicResource FpStandard}" Tag="standard"/>
                                        <ComboBoxItem Content="{DynamicResource FpStrong}"   Tag="strong"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- DOWNLOAD SETTINGS -->
                        <Border x:Name="BorderDownload" Style="{StaticResource Card}"
                                Visibility="Collapsed" Opacity="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblDlTitle}" FontSize="10"
                                           Foreground="{DynamicResource TextSec}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtTitleDl"
                                         Tag="{DynamicResource DlTitlePlaceholder}"/>
                                <TextBlock Text="{DynamicResource LblQuality}" FontSize="10"
                                           Foreground="{DynamicResource TextSec}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="CmbQuality" SelectedIndex="0">
                                    <ComboBoxItem x:Name="CmbItemBest" Content="{DynamicResource QualityBest}" Tag="best"/>
                                    <ComboBoxItem x:Name="CmbItem1080" Content="1080p" Tag="1080"/>
                                    <ComboBoxItem x:Name="CmbItem720" Content="720p" Tag="720"/>
                                    <ComboBoxItem x:Name="CmbItem480" Content="480p" Tag="480"/>
                                    <ComboBoxItem x:Name="CmbItem360" Content="360p" Tag="360"/>
                                    <ComboBoxItem x:Name="CmbItemAudio" Content="{DynamicResource QualityAudio}" Tag="audio"/>
                                    <ComboBoxItem x:Name="CmbItemYt320" Content="{DynamicResource QualityYTMusic320}" Tag="ytmusic_320k" Visibility="Collapsed"/>
                                    <ComboBoxItem x:Name="CmbItemYtM4a" Content="{DynamicResource QualityYTMusicM4a}" Tag="ytmusic_m4a" Visibility="Collapsed"/>
                                    <ComboBoxItem x:Name="CmbItemYtFlac" Content="{DynamicResource QualityYTMusicFlac}" Tag="ytmusic_flac" Visibility="Collapsed"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource LblSavePath}" FontSize="10"
                                           Foreground="{DynamicResource TextSec}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtOutputDir" IsReadOnly="True"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource OutlineBtn}"
                                            Content="{DynamicResource BtnBrowse}"
                                            Margin="8,0,0,0" Click="Browse_Click"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkFingerprintDl" Style="{StaticResource SubtleToggleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblFingerprintDl" Text="Fingerprint" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ChkFingerprintDl}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbFingerprintMethodDl" Grid.Column="1"
                                              Margin="8,0,0,0" SelectedIndex="2"
                                              IsEnabled="{Binding IsChecked, ElementName=ChkFingerprintDl}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBoxItem Content="{DynamicResource FpMetadata}" Tag="metadata"/>
                                        <ComboBoxItem Content="{DynamicResource FpLight}"    Tag="light"/>
                                        <ComboBoxItem Content="{DynamicResource FpStandard}" Tag="standard"/>
                                        <ComboBoxItem Content="{DynamicResource FpStrong}"   Tag="strong"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- COMPLETED ACTIONS CONTAINER (shown after successful job) -->
                        <Border x:Name="BorderCompletedActions" Style="{StaticResource Card}"
                                Visibility="Collapsed" Opacity="0"
                                Margin="0,2,0,0">
                            <StackPanel>
                                <Button x:Name="BtnOpenFileLocation"
                                        Style="{StaticResource OutlineBtn}"
                                        Margin="0,0,0,8" Height="36"
                                        Click="OpenFileLocation_Click"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📂" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource BtnOpenFileLocation}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenInEditor"
                                        Style="{StaticResource OutlineBtn}"
                                        Height="36"
                                        Click="OpenInEditor_Click"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🎬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource BtnOpenInEditor}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- MORPHING START BUTTON & PROGRESS BAR -->
                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Liquid Morphing Start Container -->
                    <Border x:Name="StartContainer" Grid.Column="0" Height="40" CornerRadius="20"
                            Background="{DynamicResource InputBg}"
                            BorderBrush="{DynamicResource BorderSub}"
                            BorderThickness="0.5"
                            ClipToBounds="True"
                            Cursor="Hand"
                            MouseLeftButtonDown="StartContainer_Click">
                        <Grid x:Name="StartGrid">
                            <!-- Idle Glass Background -->
                            <Border x:Name="StartIdleBg" CornerRadius="20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#36FFFFFF" Offset="0"/>
                                        <GradientStop Color="#24FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#50FFFFFF" Offset="0"/>
                                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>

                            <!-- Inner Glass Track Groove (Visible when running) -->
                            <Border x:Name="StartTrackGroove" CornerRadius="20" Background="#20000000" Visibility="Collapsed"/>

                            <!-- Morphing Floating Liquid Progress Fill Capsule (Glass Grey Material) -->
                            <Border x:Name="StartProgressFill" Height="34" Margin="3" CornerRadius="17"
                                    Width="0" HorizontalAlignment="Left" ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3D4250" Offset="0"/>
                                        <GradientStop Color="#2B2F3A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <!-- Specular Top Gloss Highlight -->
                                    <Border Height="17" VerticalAlignment="Top" CornerRadius="17,17,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Bottom Sheen Line -->
                                    <Border Height="1" VerticalAlignment="Bottom" Margin="4,0,4,1" Background="#20FFFFFF"/>
                                </Grid>
                            </Border>

                            <!-- Floating Label Overlay -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="16,0">
                                <TextBlock x:Name="TxtStartLabel" Text="{DynamicResource BtnStart}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.5"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>

                            <!-- Glass Refraction Overlay -->
                            <Border CornerRadius="20" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#18FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#0CFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Log Button -->
                    <Button x:Name="BtnMainLog" Grid.Column="1"
                            Style="{StaticResource GlassPillBtn}"
                            Margin="8,0,0,0" IsEnabled="False"
                            Visibility="Collapsed"
                            VerticalAlignment="Stretch"
                            Click="MainLog_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="10" Margin="0,0,4,0"/>
                            <TextBlock Text="Log"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ═══════════ DEV CONSOLE ═══════════ -->
            <Border x:Name="BorderDevConsole" Grid.Row="2" Visibility="Collapsed"
                    Background="{DynamicResource InputBg}"
                    BorderBrush="{DynamicResource BorderSub}"
                    BorderThickness="0.5"
                    CornerRadius="14"
                    Margin="8,0,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition x:Name="DevConsoleContentRow" Height="120"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Border Grid.Row="0" Padding="12,0" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="DevConsole_MouseLeftButtonDown"
                            BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,0,0,0.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource DevConsoleTitle}" FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnDevConsoleHelp"
                                        Style="{StaticResource IconBtn}"
                                        Width="22" Height="22" Margin="0,0,2,0"
                                        Click="DevConsoleHelp_Click"
                                        ToolTip="{DynamicResource DevConsoleHelpTip}">
                                    <TextBlock Text="?" FontSize="9.5" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource IconBtn}"
                                        Width="22" Height="22" Margin="0,0,2,0"
                                        Click="ClearDevConsole_Click"
                                        ToolTip="{DynamicResource DevConsoleClear}">
                                    <TextBlock Text="🗑" FontSize="9"/>
                                </Button>
                                <Button Style="{StaticResource IconBtn}"
                                        Width="22" Height="22" Margin="0,0,2,0"
                                        Click="CollapseDevConsole_Click"
                                        ToolTip="{DynamicResource DevConsoleCollapse}">
                                    <TextBlock x:Name="TxtCollapseIcon" Text="▾" FontSize="9"/>
                                </Button>
                                <Button Style="{StaticResource IconBtn}"
                                        Width="22" Height="22" Margin="0,0,0,0"
                                        Click="DetachDevConsole_Click"
                                        ToolTip="{DynamicResource DevConsoleDetach}">
                                    <TextBlock Text="🗗" FontSize="9"/>
                                </Button>
                            </StackPanel>
                            <Popup x:Name="DevConsoleHelpPopup"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="None">
                                <Border x:Name="DevHelpPopupBorder"
                                        Background="#D5202024"
                                        BorderBrush="#557A9EC0" BorderThickness="1"
                                        anim:FluidMotion.CornerRadiusValue="55"
                                        Padding="10,8" MinWidth="260" MaxHeight="250"
                                        Opacity="0" RenderTransformOrigin="0.5,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="2" Color="#7A9EC0" Opacity="0.25"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                            <TranslateTransform Y="-4"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource DevConsoleHelpTitle}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSec}" Margin="0,0,0,8"/>
                                            
                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="help" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdHelpDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="clear / cls" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdClearDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="status" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdStatusDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="ping" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdPingDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="restart" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdRestartDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="config" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdConfigDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="python" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdPythonDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="ffmpeg" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdFfmpegDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="open &lt;downloads|appdata&gt;" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdOpenDesc}" Margin="0,0,0,5"/>

                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}" Text="info" Margin="0,0,0,1"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource CmdInfoDesc}" Margin="0,0,0,6"/>

                                            <Border Height="1" Background="{DynamicResource BorderSub}" Margin="0,2,0,6"/>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource TextSec}"
                                                       Text="{DynamicResource CmdFallbackDesc}"
                                                       TextWrapping="Wrap" FontStyle="Italic"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!-- Console body -->
                    <Grid x:Name="DevConsoleBody" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtDevConsole" Grid.Row="0" Style="{x:Null}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="#57C58A" FontFamily="Cascadia Code, Consolas" FontSize="10.5"
                                  IsReadOnly="True" TextWrapping="Wrap"
                                  VerticalScrollBarVisibility="Auto" Padding="12,8"/>
                        <Border Grid.Row="1"
                                Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource BorderSub}"
                                BorderThickness="0,0.5,0,0" Padding="12,6"
                                CornerRadius="0,0,14,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="›" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtDevConsoleInput" Grid.Column="1" Style="{x:Null}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimary}" FontFamily="Cascadia Code, Consolas" FontSize="11"
                                         CaretBrush="{DynamicResource Accent}" Padding="0"
                                         KeyDown="TxtDevConsoleInput_KeyDown"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Drag & Drop Glass Overlay -->
            <Grid x:Name="GridDragDropOverlay" Grid.Row="0" Grid.RowSpan="3"
                  Background="#E0101014" Visibility="Collapsed" Opacity="0"
                  AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">
                <Border x:Name="DragDropOverlayContent" Margin="24" CornerRadius="16"
                        Background="#0DFFFFFF"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <!-- Dashed border visualization inside the card -->
                    <Grid>
                        <!-- A Rectangle to easily draw the dashed outline -->
                        <Rectangle x:Name="DragDropDashedBorder" Margin="8" RadiusX="12" RadiusY="12"
                                   Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                   StrokeDashArray="4 3" Opacity="0.5"/>
                        
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                            <!-- Icon/Loading Indicator -->
                            <Grid Height="64">
                                <TextBlock x:Name="TxtDragIcon" Text="📥" FontSize="54" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                <!-- Loading Spinner -->
                                <TextBlock x:Name="TxtDragSpinner" Text="⏳" FontSize="44" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Accent}"
                                           Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                            
                            <!-- Prompt/Status Text -->
                            <TextBlock x:Name="TxtDragPrompt" Text="{DynamicResource DragDropOverlayText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,16,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            
                            <!-- Progress Bar -->
                            <ProgressBar x:Name="DragProgress" Height="6" BorderThickness="0"
                                         Background="#15FFFFFF" Foreground="{DynamicResource Accent}"
                                         IsIndeterminate="True" Margin="0,20,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════ LANGUAGE SELECTOR POPUP ═══════════ -->
            <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=BtnLangPill}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                   PopupAnimation="None" Closed="LangPopup_Closed">
                <Border x:Name="LangPopupBorder"
                        Background="{DynamicResource PopupBg}"
                        BorderBrush="{DynamicResource BorderSub}"
                        BorderThickness="0.5" CornerRadius="12"
                        Padding="4,6" Margin="0,4,0,0" MinWidth="135"
                        RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform Y="-6"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="Black" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="de">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇩🇪" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Deutsch" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="CheckLangDE" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="en">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇬🇧" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="English" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="CheckLangEN" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="es">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇪🇸" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Español" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="CheckLangES" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="fr">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇫🇷" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Français" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="CheckLangFR" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="it">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇮🇹" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Italiano" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="CheckLangIT" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="ja">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇯🇵" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="日本語" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="CheckLangJA" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="zh">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇨🇳" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="中文" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="CheckLangZH" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="22" Height="22" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    ToolTip="Drag to resize window"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style quarter-circle resize indicator -->
                <Viewbox>
                    <Grid Width="24" Height="24">
                <!-- Concave arc: opens toward window interior (iPadOS corner grip) -->
                <Path Data="M 0,22 A 22,22 0 0,0 22,0"
                      Stroke="{DynamicResource TextSec}"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.6"
                      Fill="Transparent"/>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</Window>


