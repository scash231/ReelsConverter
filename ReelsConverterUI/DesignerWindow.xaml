<Window x:Class="ReelsConverterUI.DesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Designer" Width="840" Height="540"
        Icon="Icons/DesignerWindow.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ TITLE BAR ═══════════ -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="🎨" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource DesignerTitle}" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource ErrorRed}"
                            Width="30" Height="30"
                            Click="Cancel_Click">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════ MAIN LAYOUT ═══════════ -->
            <Grid Grid.Row="1" Margin="12,2,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE: TABS CONTAINER -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Selector Capsule -->
                    <Border x:Name="TabsBar" Grid.Row="0" Margin="0,0,0,8" Padding="3"
                            CornerRadius="16" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabPresetsBtn" Style="{StaticResource SegmentedBtn}" Width="80"
                                         Content="Presets" IsChecked="True" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabCustomBtn" Style="{StaticResource SegmentedBtn}" Width="115"
                                         Content="Custom Presets" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabCustomizeBtn" Style="{StaticResource SegmentedBtn}" Width="85"
                                         Content="Customize" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabStyleBtn" Style="{StaticResource SegmentedBtn}" Width="105"
                                         Content="Window Style" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                        </StackPanel>
                    </Border>

                    <!-- TAB CONTENTS -->
                    <Grid Grid.Row="1">
                        
                        <!-- TAB 1: PRESETS -->
                        <Border x:Name="PanelPresets" Style="{StaticResource Card}" Padding="12" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransPresets"/>
                            </Border.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource DesignerPresets}" Margin="0,0,0,8"/>
                                    <!-- Dynamic Presets Grid -->
                                    <WrapPanel x:Name="PresetsPanel" Margin="0,0,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- TAB 1.5: CUSTOM PRESETS -->
                        <Border x:Name="PanelCustom" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransCustom"/>
                            </Border.RenderTransform>
                            <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="*"/>
                                 </Grid.RowDefinitions>
                                 
                                 <TextBlock Grid.Row="0" Style="{StaticResource Lbl}" Text="CUSTOM PRESETS" Margin="0,0,0,8"/>
                                 
                                 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                     <!-- Custom Presets Grid -->
                                     <WrapPanel x:Name="CustomPresetsPanel" Margin="0,0,0,0" HorizontalAlignment="Center"/>
                                 </ScrollViewer>
                             </Grid>
                        </Border>

                        <!-- TAB 2: CUSTOMIZE -->
                        <Grid x:Name="PanelCustomize" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="TransCustomize"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Variable Category Tree -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CategoryPanel"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Color Customization (Sliders + Color Grid) -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- Variable Swatch/Label -->
                                        <RowDefinition Height="*"/>      <!-- Sliders -->
                                        <RowDefinition Height="Auto"/>   <!-- HEX + RGB row -->
                                        <RowDefinition Height="Auto"/>   <!-- Curated Palette Grid -->
                                    </Grid.RowDefinitions>

                                    <!-- Active Variable -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border x:Name="ActiveSwatch" Width="20" Height="20"
                                                CornerRadius="5" Background="#7A9EC0"
                                                BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtActiveLabel" Text="Select a color"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="TxtActiveKey" Text=""
                                                   FontSize="9.5" Foreground="{DynamicResource TextSec}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <!-- HSL Fine-Tuning Sliders -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <!-- Hue -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Hue" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderHue" Grid.Column="1" Minimum="0" Maximum="360" ValueChanged="SliderHue_ValueChanged" VerticalAlignment="Center">
                                                <Slider.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF0000" Offset="0.00"/>
                                                        <GradientStop Color="#FFFF00" Offset="0.17"/>
                                                        <GradientStop Color="#00FF00" Offset="0.33"/>
                                                        <GradientStop Color="#00FFFF" Offset="0.50"/>
                                                        <GradientStop Color="#0000FF" Offset="0.67"/>
                                                        <GradientStop Color="#FF00FF" Offset="0.83"/>
                                                        <GradientStop Color="#FF0000" Offset="1.00"/>
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                            <TextBlock x:Name="TxtHueVal" Grid.Column="2" Text="0°" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Saturation -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Saturation" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderSat" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="SliderSat_ValueChanged" VerticalAlignment="Center">
                                                <Slider.Background>
                                                    <LinearGradientBrush x:Name="SatBrush" StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#808080" Offset="0"/>
                                                        <GradientStop Color="#FF0000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                            <TextBlock x:Name="TxtSatVal" Grid.Column="2" Text="0%" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Value (Brightness) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderVal" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="SliderVal_ValueChanged" VerticalAlignment="Center">
                                                <Slider.Background>
                                                    <LinearGradientBrush x:Name="ValBrush" StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#000000" Offset="0"/>
                                                        <GradientStop Color="#FF0000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                            <TextBlock x:Name="TxtValVal" Grid.Column="2" Text="0%" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- HEX / RGB Fields -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="HEX" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtHexInput" Grid.Column="1" FontSize="11.5" MaxLength="7" FontFamily="Consolas" Padding="4,3" VerticalAlignment="Center" TextChanged="TxtHexInput_Changed"/>

                                        <TextBlock Grid.Column="3" Text="R" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtR" Grid.Column="4" FontSize="10.5" MaxLength="3" FontFamily="Consolas" Padding="2,3" VerticalAlignment="Center" TextChanged="RgbInput_Changed"/>

                                        <TextBlock Grid.Column="6" Text="G" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtG" Grid.Column="7" FontSize="10.5" MaxLength="3" FontFamily="Consolas" Padding="2,3" VerticalAlignment="Center" TextChanged="RgbInput_Changed"/>

                                        <TextBlock Grid.Column="9" Text="B" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtB" Grid.Column="10" FontSize="10.5" MaxLength="3" FontFamily="Consolas" Padding="2,3" VerticalAlignment="Center" TextChanged="RgbInput_Changed"/>
                                    </Grid>

                                    <!-- Palette Grid -->
                                    <StackPanel Grid.Row="3">
                                        <TextBlock Style="{StaticResource Lbl}" Text="PALETTE COLORS" Margin="0,0,0,6"/>
                                        <WrapPanel x:Name="PaletteGridPanel" HorizontalAlignment="Left" ItemWidth="20" ItemHeight="20"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 3: WINDOW STYLE -->
                        <Border x:Name="PanelStyle" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransStyle"/>
                            </Border.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Lbl}" Text="WINDOW STYLING" Margin="0,0,0,10"/>
                                    
                                    <!-- Card: Adaptive tinting -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Adaptive Accent Tinting" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                <TextBlock Text="Tints window accent based on loaded thumbnail dominant colors." FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAdaptiveTheme" Grid.Column="1" VerticalAlignment="Center" Checked="ChkAdaptiveTheme_Changed" Unchecked="ChkAdaptiveTheme_Changed"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card: Glass transparency -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Glass Transparency" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Adjust transparency of application window backdrops." FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtGlassOpacityPct" Grid.Column="1" Text="100%" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderGlassOpacity" Minimum="50" Maximum="100" Value="100" SmallChange="1" LargeChange="10" ValueChanged="SliderGlassOpacity_ValueChanged" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card: Interface Animations -->
                                     <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="Auto"/>
                                             </Grid.ColumnDefinitions>
                                             <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                 <TextBlock Text="Interface Animations" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                 <TextBlock Text="Adjust standard UI motion effects: standard, reduced, or disabled." FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                             </StackPanel>
                                             <Border Grid.Column="1" VerticalAlignment="Center" Padding="3" CornerRadius="10" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5">
                                                 <StackPanel Orientation="Horizontal">
                                                     <RadioButton x:Name="RadAnimStandard" Content="Standard" IsChecked="True" GroupName="AnimSettings" Style="{StaticResource TabBtn}" Width="75" Checked="AnimLevel_Checked"/>
                                                     <RadioButton x:Name="RadAnimReduced" Content="Reduced" GroupName="AnimSettings" Style="{StaticResource TabBtn}" Width="75" Checked="AnimLevel_Checked"/>
                                                     <RadioButton x:Name="RadAnimNone" Content="Disabled" GroupName="AnimSettings" Style="{StaticResource TabBtn}" Width="75" Checked="AnimLevel_Checked"/>
                                                 </StackPanel>
                                             </Border>
                                         </Grid>
                                     </Border>

                                    <!-- Card: Liquid Glass in other windows -->
                                    <Border Background="#06FFFFFF" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Liquid Glass Windows" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Select which windows should use composition blur backdrops:" FontSize="10.5" Foreground="{DynamicResource TextSec}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                            <UniformGrid Columns="2">
                                                <CheckBox x:Name="ChkBlurMain" Content="Main Window" Margin="0,0,0,6" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                <CheckBox x:Name="ChkBlurEditor" Content="Video Editor" Margin="0,0,0,6" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                <CheckBox x:Name="ChkBlurSettings" Content="Settings" Margin="0,0,0,6" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                <CheckBox x:Name="ChkBlurLogViewer" Content="Log Viewer" Margin="0,0,0,6" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                <CheckBox x:Name="ChkBlurDevConsole" Content="Dev Console" Margin="0,0,0,6" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                <CheckBox x:Name="ChkBlurDescEditor" Content="Description Editor" Margin="0,0,0,6" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                    </Grid>
                </Grid>

                <!-- VERTICAL SEPARATOR -->
                <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSub}" Margin="4,2,4,4"/>

                <!-- RIGHT SIDE: LIVE PREVIEW PANEL -->
                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Style="{StaticResource Lbl}" Text="LIVE PREVIEW" Margin="4,2,0,6"/>

                    <Border Grid.Row="1" x:Name="PrvOuter" CornerRadius="12" BorderThickness="0.5" Padding="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Mock Titlebar -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#40FFFFFF"/>
                                    <TextBlock x:Name="PrvTitle" Text="VideoConverter" FontSize="10.5" FontWeight="Bold" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="12" Height="1.5" Background="#40FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Width="6" Height="6" CornerRadius="3" BorderThickness="1.5" BorderBrush="#40FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#40FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Mock Window Body -->
                            <Border Grid.Row="1" x:Name="PrvCard" CornerRadius="8" Padding="10" BorderThickness="0.5">
                                <StackPanel>
                                    <!-- Search input mockup -->
                                    <Border x:Name="PrvInput" CornerRadius="6" Padding="6,4" BorderThickness="0.5" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="PrvInputText" Text="https://www.youtube.com/..." FontSize="9.5" Foreground="{DynamicResource TextSec}"/>
                                            <TextBlock Text="📋" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Tabs mockup -->
                                    <Border Height="20" CornerRadius="10" Background="#0AFFFFFF" Padding="2" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="8" Background="#22FFFFFF">
                                                <TextBlock Text="Upload" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Download" FontSize="8.5" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Content card mockup -->
                                    <Border x:Name="PrvContentCard" Background="#06FFFFFF" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="PrvTextHeading" Text="Video Title Preview" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="PrvSubtitle" Text="channel info • 04:22" FontSize="9.5" Foreground="{DynamicResource TextSec}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Progress bar mockup -->
                                    <Border x:Name="PrvProgressTrack" Height="4" CornerRadius="2" Background="#15FFFFFF" Margin="0,0,0,10">
                                        <Border x:Name="PrvProgressFill" Height="4" CornerRadius="2" Width="120" HorizontalAlignment="Left"/>
                                    </Border>

                                    <!-- Buttons / Status row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PrvButton" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left">
                                            <TextBlock x:Name="PrvBtnText" Text="Start" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="PrvDotOk" Width="6" Height="6" CornerRadius="3" Margin="0,0,4,0"/>
                                            <Border x:Name="PrvDotErr" Width="6" Height="6" CornerRadius="3"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <!-- ═══════════ FOOTER ═══════════ -->
            <Grid Grid.Row="2" Margin="12,6,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{DynamicResource DesignerReset}"
                        Style="{StaticResource OutlineBtn}"
                        Click="Reset_Click"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource BtnCancelSettings}"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Grid.Column="3"
                        Content="{DynamicResource BtnSaveSettings}"
                        Style="{StaticResource GradRectBtn}" Width="100"
                        Click="Save_Click"/>
            </Grid>

            <!-- Modern Popup Overlay Dialog for Saving Custom Theme -->
            <Grid x:Name="DlgOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#A0000000" Visibility="Collapsed" Panel.ZIndex="1000">
                <Border Width="340" Height="170" CornerRadius="16" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Save Custom Theme" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBox x:Name="TxtOverlayPresetName" Grid.Row="1" Height="32" VerticalContentAlignment="Center" Padding="8,0" SelectionBrush="{DynamicResource Accent}" Margin="0,0,0,12" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Margin="0,0,6,0" Style="{StaticResource OutlineBtn}" Height="30" Click="CancelOverlay_Click"/>
                            <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" Style="{StaticResource GradRectBtn}" Height="30" Click="SaveOverlay_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
