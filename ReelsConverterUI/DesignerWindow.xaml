<Window x:Class="ReelsConverterUI.DesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Designer" Width="680" Height="500"
        Icon="Icons/DesignerWindow.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- ToggleSwitch (CheckBox) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10">
                            <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="#E6FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,3,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform/>
                                        <ScaleTransform/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)" 
                                                             To="18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.4">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.82">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)" 
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.4">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.82">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ TITLE BAR ═══════════ -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Customization" FontWeight="SemiBold"
                                   FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource ErrorRed}"
                            Width="30" Height="30"
                            Click="Cancel_Click">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════ MAIN LAYOUT ═══════════ -->
            <Grid Grid.Row="1" Margin="14,2,14,0">
                <!-- TABS CONTAINER -->
                <Grid HorizontalAlignment="Stretch" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Selector Capsule -->
                    <Border x:Name="TabsBar" Grid.Row="0" Margin="0,0,0,8" Padding="3"
                            CornerRadius="16" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabPresetsBtn" Style="{StaticResource SegmentedBtn}" Padding="13,6" FontSize="12"
                                         Content="{DynamicResource DesignerTabPresets}" IsChecked="True" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabCustomBtn" Style="{StaticResource SegmentedBtn}" Padding="13,6" FontSize="12"
                                         Content="{DynamicResource DesignerTabCustomPresets}" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabCustomizeBtn" Style="{StaticResource SegmentedBtn}" Padding="13,6" FontSize="12"
                                         Content="{DynamicResource DesignerTabCustomize}" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabStyleBtn" Style="{StaticResource SegmentedBtn}" Padding="13,6" FontSize="12"
                                         Content="Effects" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabLayoutBtn" Style="{StaticResource SegmentedBtn}" Padding="13,6" FontSize="12"
                                         Content="Layout" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                            <RadioButton x:Name="TabAnimBtn" Style="{StaticResource SegmentedBtn}" Padding="13,6" FontSize="12"
                                         Content="Animations" Checked="Tab_Checked" GroupName="DesignerTabs"/>
                        </StackPanel>
                    </Border>

                    <!-- TAB CONTENTS -->
                    <Grid Grid.Row="1">
                        
                        <!-- TAB 1: PRESETS -->
                        <Border x:Name="PanelPresets" Style="{StaticResource Card}" Padding="12" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransPresets"/>
                            </Border.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,6,4,4">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource DesignerPresets}" Margin="0,0,0,8"/>
                                    <!-- Dynamic Presets Grid -->
                                    <WrapPanel x:Name="PresetsPanel" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- TAB 1.5: CUSTOM PRESETS -->
                        <Border x:Name="PanelCustom" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransCustom"/>
                            </Border.RenderTransform>
                            <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="*"/>
                                 </Grid.RowDefinitions>
                                 
                                 <TextBlock Grid.Row="0" Style="{StaticResource Lbl}" Text="{DynamicResource DesignerCustomPresetsHeader}" Margin="0,0,0,8"/>
                                 
                                 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,6,4,4">
                                     <!-- Custom Presets Grid -->
                                     <WrapPanel x:Name="CustomPresetsPanel" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                 </ScrollViewer>
                             </Grid>
                        </Border>

                        <!-- TAB 2: CUSTOMIZE -->
                        <Grid x:Name="PanelCustomize" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="TransCustomize"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Variable Category Tree -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CategoryPanel"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Color Customization (Sliders + Color Grid) -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- Variable Swatch/Label -->
                                        <RowDefinition Height="*"/>      <!-- Sliders -->
                                        <RowDefinition Height="Auto"/>   <!-- HEX + RGB row -->
                                        <RowDefinition Height="Auto"/>   <!-- Curated Palette Grid -->
                                    </Grid.RowDefinitions>

                                    <!-- Active Variable -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border x:Name="ActiveSwatch" Width="20" Height="20"
                                                CornerRadius="5" Background="#7A9EC0"
                                                BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtActiveLabel" Text="{DynamicResource DesignerSelectColor}"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="TxtActiveKey" Text=""
                                                   FontSize="9.5" Foreground="{DynamicResource TextSec}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <!-- HSL Fine-Tuning Sliders -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <!-- Hue -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource DesignerHue}" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderHue" Grid.Column="1" Minimum="0" Maximum="360" ValueChanged="SliderHue_ValueChanged" VerticalAlignment="Center">
                                                <Slider.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF0000" Offset="0.00"/>
                                                        <GradientStop Color="#FFFF00" Offset="0.17"/>
                                                        <GradientStop Color="#00FF00" Offset="0.33"/>
                                                        <GradientStop Color="#00FFFF" Offset="0.50"/>
                                                        <GradientStop Color="#0000FF" Offset="0.67"/>
                                                        <GradientStop Color="#FF00FF" Offset="0.83"/>
                                                        <GradientStop Color="#FF0000" Offset="1.00"/>
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                            <TextBlock x:Name="TxtHueVal" Grid.Column="2" Text="0°" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Saturation -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource DesignerSaturation}" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderSat" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="SliderSat_ValueChanged" VerticalAlignment="Center">
                                                <Slider.Background>
                                                    <LinearGradientBrush x:Name="SatBrush" StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#808080" Offset="0"/>
                                                        <GradientStop Color="#FF0000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                            <TextBlock x:Name="TxtSatVal" Grid.Column="2" Text="0%" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Value (Brightness) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource DesignerBrightness}" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderVal" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="SliderVal_ValueChanged" VerticalAlignment="Center">
                                                <Slider.Background>
                                                    <LinearGradientBrush x:Name="ValBrush" StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#000000" Offset="0"/>
                                                        <GradientStop Color="#FF0000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                            <TextBlock x:Name="TxtValVal" Grid.Column="2" Text="0%" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- HEX / RGB Fields -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="HEX" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtHexInput" Grid.Column="1" FontSize="11.5" MaxLength="7" FontFamily="Consolas" Padding="4,3" VerticalAlignment="Center" TextChanged="TxtHexInput_Changed"/>

                                        <TextBlock Grid.Column="3" Text="R" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtR" Grid.Column="4" FontSize="10.5" MaxLength="3" FontFamily="Consolas" Padding="2,3" VerticalAlignment="Center" TextChanged="RgbInput_Changed"/>

                                        <TextBlock Grid.Column="6" Text="G" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtG" Grid.Column="7" FontSize="10.5" MaxLength="3" FontFamily="Consolas" Padding="2,3" VerticalAlignment="Center" TextChanged="RgbInput_Changed"/>

                                        <TextBlock Grid.Column="9" Text="B" FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtB" Grid.Column="10" FontSize="10.5" MaxLength="3" FontFamily="Consolas" Padding="2,3" VerticalAlignment="Center" TextChanged="RgbInput_Changed"/>
                                    </Grid>

                                    <!-- Palette Grid -->
                                    <StackPanel Grid.Row="3">
                                        <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource DesignerPaletteHeader}" Margin="0,0,0,6"/>
                                        <WrapPanel x:Name="PaletteGridPanel" HorizontalAlignment="Left" ItemWidth="20" ItemHeight="20"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 3: EFFECTS -->
                        <Border x:Name="PanelStyle" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransStyle"/>
                            </Border.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Lbl}" Text="VISUAL EFFECTS" Margin="0,0,0,10"/>
                                    <!-- Card: Adaptive tinting -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{DynamicResource DesignerAdaptiveTintingTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{DynamicResource DesignerAdaptiveTintingDesc}" FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAdaptiveTheme" Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" Checked="ChkAdaptiveTheme_Changed" Unchecked="ChkAdaptiveTheme_Changed"/>
                                        </Grid>
                                    </Border>
                                    <!-- Card: Glass transparency -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="{DynamicResource DesignerGlassTransparencyTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource DesignerGlassTransparencyDesc}" FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtGlassOpacityPct" Grid.Column="1" Text="100%" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SliderGlassOpacity" Minimum="50" Maximum="100" Value="100" SmallChange="1" LargeChange="10" ValueChanged="SliderGlassOpacity_ValueChanged" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Card: Dynamic Accent Gradient Target -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="Dynamic Gradient Effect" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                <TextBlock Text="Target for video thumbnail dominant color gradient" FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbGradEffectMode" Grid.Column="1" Width="185" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="CmbGradEffectMode_SelectionChanged">
                                                <ComboBoxItem Content="Thumbnail Card Only" Tag="thumbnail_only"/>
                                                <ComboBoxItem Content="Card &amp; Background Both" Tag="both"/>
                                                <ComboBoxItem Content="Disabled (None)" Tag="none"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                     <!-- Card: Liquid Glass in other windows (Collapsible) -->
                                     <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12">
                                         <StackPanel>
                                             <!-- Clickable Header Row -->
                                             <Grid x:Name="HeaderLiquidGlass" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="HeaderLiquidGlass_Click">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                 </Grid.ColumnDefinitions>
                                                 <StackPanel Margin="0,0,10,0">
                                                     <TextBlock Text="{DynamicResource DesignerLiquidGlassTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                     <TextBlock Text="{DynamicResource DesignerLiquidGlassDesc}" FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                 </StackPanel>
                                                 <TextBlock x:Name="TxtLiquidGlassArrow" Grid.Column="1" Text="˅" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="6,0,2,0" RenderTransformOrigin="0.5,0.5">
                                                     <TextBlock.RenderTransform>
                                                         <RotateTransform x:Name="RotLiquidGlassArrow" Angle="0"/>
                                                     </TextBlock.RenderTransform>
                                                 </TextBlock>
                                             </Grid>

                                             <!-- Collapsible Content Panel -->
                                             <StackPanel x:Name="PanelLiquidGlassBody" Visibility="Collapsed" Opacity="0" Margin="0,12,0,0" RenderTransformOrigin="0.5,0">
                                                 <StackPanel.RenderTransform>
                                                     <TranslateTransform x:Name="TransLiquidGlassBody" Y="-6"/>
                                                 </StackPanel.RenderTransform>
                                                 <Grid Margin="0,0,0,8">
                                                     <TextBlock Text="{DynamicResource WindowTagMain}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                     <CheckBox x:Name="ChkBlurMain" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                 </Grid>
                                                 <Grid Margin="0,0,0,8">
                                                     <TextBlock Text="{DynamicResource WindowTagEditor}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                     <CheckBox x:Name="ChkBlurEditor" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                 </Grid>
                                                 <Grid Margin="0,0,0,8">
                                                     <TextBlock Text="{DynamicResource WindowTagSettings}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                     <CheckBox x:Name="ChkBlurSettings" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                 </Grid>
                                                 <Grid Margin="0,0,0,8">
                                                     <TextBlock Text="{DynamicResource WindowTagLog}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                     <CheckBox x:Name="ChkBlurLogViewer" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                 </Grid>
                                                 <Grid Margin="0,0,0,8">
                                                     <TextBlock Text="{DynamicResource WindowTagConsole}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                     <CheckBox x:Name="ChkBlurDevConsole" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                 </Grid>
                                                 <Grid Margin="0,0,0,0">
                                                     <TextBlock Text="{DynamicResource WindowTagDesc}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                     <CheckBox x:Name="ChkBlurDescEditor" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="BlurCheck_Changed" Unchecked="BlurCheck_Changed"/>
                                                 </Grid>
                                             </StackPanel>
                                         </StackPanel>
                                     </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- TAB 4: LAYOUT -->
                        <Border x:Name="PanelLayout" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransLayout"/>
                            </Border.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Lbl}" Text="LAYOUT &amp; MOTION" Margin="0,0,0,10"/>
                                    <!-- Card: Enable/Disable Borders -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{DynamicResource DesignerEnableBordersTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{DynamicResource DesignerEnableBordersDesc}" FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkEnableBorders" Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" Checked="ChkEnableBorders_Changed" Unchecked="ChkEnableBorders_Changed"/>
                                        </Grid>
                                    </Border>
                                    <!-- Card: Compact Mode -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Compact Mode" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                <TextBlock Text="Reduces card padding and spacing for a denser, more information-dense layout." FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkCompactMode" Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" Checked="ChkLayoutOption_Changed" Unchecked="ChkLayoutOption_Changed"/>
                                        </Grid>
                                    </Border>
                                    <!-- Card: Hide Scrollbars -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Hide Scrollbars" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                <TextBlock Text="Hides visible scrollbars while keeping scroll functionality active (scroll with mouse wheel)." FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkHideScrollbars" Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" Checked="ChkLayoutOption_Changed" Unchecked="ChkLayoutOption_Changed"/>
                                        </Grid>
                                    </Border>
                                    <!-- Card: Auto-show Progress Window -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Auto-Show Progress Details" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                <TextBlock Text="Automatically opens the detailed progress window when a download starts." FontSize="10.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoProgress" Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" Checked="ChkLayoutOption_Changed" Unchecked="ChkLayoutOption_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- TAB 6: ANIMATIONS -->
                        <Border x:Name="PanelAnim" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransAnim"/>
                            </Border.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,2,2,4">
                                <StackPanel>
                                    <!-- Header Block -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Motion &amp; Animations" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Select a motion profile or customize visual animation behavior across the app." FontSize="10.5" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Hidden ComboBox for legacy compatibility -->
                                    <ComboBox x:Name="CmbAnimPreset" Visibility="Collapsed" SelectionChanged="CmbAnimPreset_Changed">
                                        <ComboBoxItem Content="Disabled (Static)"/>
                                        <ComboBoxItem Content="Subtle"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="Smooth Liquid"/>
                                        <ComboBoxItem Content="Hyper Fluid"/>
                                    </ComboBox>

                                    <!-- SECTION 1: MOTION PROFILES (ALWAYS VISIBLE) -->
                                    <TextBlock Text="MOTION PROFILE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSec}" Margin="2,0,0,6"/>
                                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,14">
                                        <!-- Card 1: Reduce Motion -->
                                        <Border x:Name="CardPresetStatic" Margin="0,0,4,4" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1.5" CornerRadius="12" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="PresetCard_Click" Tag="Disabled (Static)">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Reduce Motion" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Static interface with instant responses." FontSize="9.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Card 2: Subtle -->
                                        <Border x:Name="CardPresetSubtle" Margin="4,0,0,4" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1.5" CornerRadius="12" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="PresetCard_Click" Tag="Subtle">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Subtle" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Fast, lightweight UI transitions." FontSize="9.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Card 3: Balanced -->
                                        <Border x:Name="CardPresetBalanced" Margin="0,4,4,0" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1.5" CornerRadius="12" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="PresetCard_Click" Tag="Balanced">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Balanced" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Standard smooth motion &amp; easing." FontSize="9.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Card 4: Smooth Liquid -->
                                        <Border x:Name="CardPresetLiquid" Margin="4,4,0,0" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1.5" CornerRadius="12" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="PresetCard_Click" Tag="Smooth Liquid">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Smooth Liquid" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Fluid Apple spring physics &amp; morphing." FontSize="9.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </UniformGrid>

                                    <!-- SECTION 2: MOTION EFFECTS (COLLAPSIBLE SUB MENU) -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Clickable Header Row -->
                                            <Grid x:Name="HeaderMotionEffects" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="HeaderMotionEffects_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Motion Effects" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Micro-interactions, tab transitions, and progress pulse" FontSize="10" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtMotionEffectsArrow" Grid.Column="1" Text="˅" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="6,0,2,0" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform x:Name="RotMotionEffectsArrow" Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Collapsible Content Panel -->
                                            <StackPanel x:Name="PanelMotionEffectsBody" Visibility="Collapsed" Opacity="0" Margin="0,10,0,0" RenderTransformOrigin="0.5,0">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="TransMotionEffectsBody" Y="-6"/>
                                                </StackPanel.RenderTransform>

                                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Opacity="0.4" Margin="0,0,0,4"/>

                                                <!-- Row 1: Hover Micro-Animations -->
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Hover &amp; Micro-Interactions" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="Expansion animation when hovering buttons and cards" FontSize="9.5" Foreground="{DynamicResource TextSec}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="ChkHoverMicro" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="ChkHoverMicro_Click" Unchecked="ChkHoverMicro_Click"/>
                                                </Grid>

                                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Opacity="0.4"/>

                                                <!-- Row 2: Tab Switch Motion -->
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Tab Switch Transition" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="Animation style when switching between tabs" FontSize="9.5" Foreground="{DynamicResource TextSec}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" x:Name="CmbTabTransition" Width="140" Height="24" VerticalAlignment="Center" SelectionChanged="CmbTabTransition_Changed">
                                                        <ComboBoxItem Content="Slide &amp; Fade"/>
                                                        <ComboBoxItem Content="Scale Morph"/>
                                                        <ComboBoxItem Content="Cross Fade"/>
                                                        <ComboBoxItem Content="Instant"/>
                                                    </ComboBox>
                                                </Grid>

                                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Opacity="0.4"/>

                                                <!-- Row 3: Staggered Entrance -->
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Staggered Entrance Animation" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="Sequentially cascade elements when opening panels" FontSize="9.5" Foreground="{DynamicResource TextSec}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="ChkStaggered" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="ChkStaggered_Click" Unchecked="ChkStaggered_Click"/>
                                                </Grid>

                                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Opacity="0.4"/>

                                                <!-- Row 4: Progress Glow Pulse -->
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Progress Glow Pulse" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="Continuous ambient pulsing effect on active progress bars" FontSize="9.5" Foreground="{DynamicResource TextSec}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="ChkProgPulse" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="ChkProgPulse_Click" Unchecked="ChkProgPulse_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECTION 3: FINE TUNING (COLLAPSIBLE SUB MENU) -->
                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Clickable Header Row -->
                                            <Grid x:Name="HeaderFineTuning" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="HeaderFineTuning_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Fine Tuning" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Window motion speed and hover scale intensity" FontSize="10" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtFineTuningArrow" Grid.Column="1" Text="˅" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="6,0,2,0" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform x:Name="RotFineTuningArrow" Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Collapsible Content Panel -->
                                            <StackPanel x:Name="PanelFineTuningBody" Visibility="Collapsed" Opacity="0" Margin="0,10,0,0" RenderTransformOrigin="0.5,0">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="TransFineTuningBody" Y="-6"/>
                                                </StackPanel.RenderTransform>

                                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Opacity="0.4" Margin="0,0,0,4"/>

                                                <!-- Speed Slider -->
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Window Motion Speed" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock x:Name="TxtWinDurVal" Text="380 ms" FontSize="9.5" Foreground="{DynamicResource TextSec}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Slider Grid.Column="1" x:Name="SliderWinDur" Width="160" VerticalAlignment="Center" Minimum="100" Maximum="600" Value="380" SmallChange="10" LargeChange="50" ValueChanged="SliderWinDur_ValueChanged"/>
                                                </Grid>

                                                <Border Height="0.5" Background="{DynamicResource BorderSub}" Opacity="0.4"/>

                                                <!-- Hover Scale Slider -->
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Hover Expansion Intensity" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock x:Name="TxtHoverScaleVal" Text="1.03x" FontSize="9.5" Foreground="{DynamicResource TextSec}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Slider Grid.Column="1" x:Name="SliderHoverScale" Width="160" VerticalAlignment="Center" Minimum="1.00" Maximum="1.10" Value="1.03" SmallChange="0.01" LargeChange="0.03" ValueChanged="SliderHoverScale_ValueChanged"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Collapsed / Advanced Controls for code compatibility -->
                                    <StackPanel Visibility="Collapsed">
                                        <ComboBox x:Name="CmbWinEasing" SelectionChanged="CmbWinEasing_Changed">
                                            <ComboBoxItem Content="Apple Spring (Bouncy)"/>
                                            <ComboBoxItem Content="Elastic Snap"/>
                                            <ComboBoxItem Content="Cubic Smooth"/>
                                            <ComboBoxItem Content="Linear Constant"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbWinStyle" SelectionChanged="CmbWinStyle_Changed">
                                            <ComboBoxItem Content="Morph &amp; Scale"/>
                                            <ComboBoxItem Content="Slide Up &amp; Fade"/>
                                            <ComboBoxItem Content="Zoom Elastic"/>
                                            <ComboBoxItem Content="Fade Only"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbDropdownStyle" SelectionChanged="CmbDropdownStyle_Changed">
                                            <ComboBoxItem Content="Scale &amp; Fade"/>
                                            <ComboBoxItem Content="Accordion Slide"/>
                                            <ComboBoxItem Content="Pop Out"/>
                                            <ComboBoxItem Content="Fade Only"/>
                                        </ComboBox>
                                        <TextBlock x:Name="TxtProgSpeedVal" Text="350 ms"/>
                                        <Slider x:Name="SliderProgSpeed" Value="350" ValueChanged="SliderProgSpeed_ValueChanged"/>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                    </Grid>
                </Grid>

            </Grid>

            <!-- ═══════════ FOOTER ═══════════ -->
            <Grid Grid.Row="2" Margin="14,6,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnFooterReset"
                        Content="{DynamicResource DesignerReset}"
                        Style="{StaticResource OutlineBtn}"
                        Click="Reset_Click"/>
                <Button Grid.Column="2" x:Name="BtnResetAnim"
                        Content="Reset Animations"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,0,8,0" Visibility="Collapsed"
                        Click="ResetAnim_Click"/>
                <Button Grid.Column="3"
                        Content="{DynamicResource BtnCancelSettings}"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Grid.Column="4" x:Name="BtnSaveOnly"
                        Content="{DynamicResource BtnSaveSettings}"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,0,8,0"
                        Click="Save_Click"/>
                <Button Grid.Column="5"
                        Content="Save &amp; Exit"
                        Style="{StaticResource GradRectBtn}" Width="105"
                        Click="SaveAndExit_Click"/>
            </Grid>

            <!-- Modern Popup Overlay Dialog for Saving Custom Theme -->
            <Grid x:Name="DlgOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#A0000000" Visibility="Collapsed" Panel.ZIndex="1000">
                <Border Width="340" Height="170" CornerRadius="16" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource DesignerSaveCustomThemeTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBox x:Name="TxtOverlayPresetName" Grid.Row="1" Height="32" VerticalContentAlignment="Center" Padding="8,0" SelectionBrush="{DynamicResource Accent}" Margin="0,0,0,12" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{DynamicResource BtnCancelSettings}" Margin="0,0,6,0" Style="{StaticResource OutlineBtn}" Height="30" Click="CancelOverlay_Click"/>
                            <Button Grid.Column="1" Content="{DynamicResource BtnSaveSettings}" Margin="6,0,0,0" Style="{StaticResource GradRectBtn}" Height="30" Click="SaveOverlay_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="22" Height="22" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    ToolTip="Drag to resize window"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style quarter-circle resize indicator -->
                <Viewbox>
                    <Grid Width="24" Height="24">
                <!-- Concave arc: opens toward window interior (iPadOS corner grip) -->
                <Path Data="M 0,22 A 22,22 0 0,0 22,0"
                      Stroke="{DynamicResource TextSec}"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.6"
                      Fill="Transparent"/>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</Window>
