<Window x:Class="ReelsConverterUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="680" Height="500"
        Icon="Icons/Settings.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- ══════ Sidebar Tab Button ══════ -->
        <Style x:Key="SidebarTabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2,8,2"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Hover Background layer -->
                                <Border x:Name="BgHover" CornerRadius="8" Background="{DynamicResource HoverBg}" Opacity="0"/>
                                <!-- Active Background layer -->
                                <Border x:Name="BgActive" CornerRadius="8" Background="{DynamicResource ActiveBg}" Opacity="0"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Selected Indicator Bar -->
                                    <Border x:Name="Indicator" Grid.Column="0" Width="3" Height="14" CornerRadius="1.5"
                                            Background="{DynamicResource Accent}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                            
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Margin="12,0,12,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Active/Checked state -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgActive" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgActive" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════ ToggleSwitch (CheckBox) ══════ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="10">
                            <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="#E6FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,3,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform/>
                                        <ScaleTransform/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Checked state -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)" 
                                                             To="18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.4">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.82">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)" 
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.4">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.82">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            
                            <!-- Hover + Checked state -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                            
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Left Sidebar (Col 0) ═══ -->
            <Border Grid.Column="0" Background="#0C000000" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,0,1,0" CornerRadius="16,0,0,16" MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,24,18,16">
                        <TextBlock Text="⚙" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tabs Menu List -->
                    <StackPanel Grid.Row="1" x:Name="TabBar" Margin="0,8,0,0">
                        <RadioButton x:Name="TabGeneral" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabGeneral}" IsChecked="True"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabWindowSizes" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabWindowSizes}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabUpload" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabUpload}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabDownload" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabDownload}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabAdvanced" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabAdvanced}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <StackPanel x:Name="PanelAdvancedSubMenu" Visibility="Collapsed" Margin="0,2,0,6">
                            <!-- Branch 1: Console -->
                            <Grid Margin="16,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Canvas Grid.Column="0" Height="28" VerticalAlignment="Top">
                                    <!-- Vertical Line Stem -->
                                    <Border Width="1.5" Height="28" Background="{DynamicResource Accent}" Opacity="0.35"
                                            HorizontalAlignment="Left" Margin="9,0,0,0" CornerRadius="1"/>
                                    <!-- Branch Curve Horizontal Connector -->
                                    <Border Width="11" Height="1.5" Background="{DynamicResource Accent}" Opacity="0.35"
                                            Margin="9,13,0,0" CornerRadius="1"/>
                                    <!-- Branch Node Dot -->
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Opacity="0.6"
                                             Margin="17,11.5,0,0"/>
                                </Canvas>
                                <RadioButton Grid.Column="1" x:Name="TabConsole" Style="{StaticResource SidebarTabBtn}"
                                             Content="{DynamicResource SettingsTabConsole}"
                                             GroupName="SettingsTab" Checked="Tab_Changed"
                                             Margin="0,1,0,1" Height="28" FontSize="11.5" FontWeight="Medium"/>
                            </Grid>

                            <!-- Branch 2: Backend -->
                            <Grid Margin="16,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Canvas Grid.Column="0" Height="28" VerticalAlignment="Top">
                                    <!-- Vertical Line Stem -->
                                    <Border Width="1.5" Height="28" Background="{DynamicResource Accent}" Opacity="0.35"
                                            HorizontalAlignment="Left" Margin="9,0,0,0" CornerRadius="1"/>
                                    <!-- Branch Curve Horizontal Connector -->
                                    <Border Width="11" Height="1.5" Background="{DynamicResource Accent}" Opacity="0.35"
                                            Margin="9,13,0,0" CornerRadius="1"/>
                                    <!-- Branch Node Dot -->
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Opacity="0.6"
                                             Margin="17,11.5,0,0"/>
                                </Canvas>
                                <RadioButton Grid.Column="1" x:Name="TabBackend" Style="{StaticResource SidebarTabBtn}"
                                             Content="Backend"
                                             GroupName="SettingsTab" Checked="Tab_Changed"
                                             Margin="0,1,0,1" Height="28" FontSize="11.5" FontWeight="Medium"/>
                            </Grid>

                            <!-- Branch 3: Developer -->
                            <Grid Margin="16,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Canvas Grid.Column="0" Height="28" VerticalAlignment="Top">
                                    <!-- Vertical Line Stem (Terminates at last item) -->
                                    <Border Width="1.5" Height="14" Background="{DynamicResource Accent}" Opacity="0.35"
                                            HorizontalAlignment="Left" Margin="9,0,0,0" CornerRadius="1"/>
                                    <!-- Branch Curve Horizontal Connector -->
                                    <Border Width="11" Height="1.5" Background="{DynamicResource Accent}" Opacity="0.35"
                                            Margin="9,13,0,0" CornerRadius="1"/>
                                    <!-- Branch Node Dot -->
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Opacity="0.6"
                                             Margin="17,11.5,0,0"/>
                                </Canvas>
                                <RadioButton Grid.Column="1" x:Name="TabDevTools" Style="{StaticResource SidebarTabBtn}"
                                             Content="Developer"
                                             GroupName="SettingsTab" Checked="Tab_Changed"
                                             Margin="0,1,0,1" Height="28" FontSize="11.5" FontWeight="Medium"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer Details -->
                    <StackPanel Grid.Row="2" Margin="18,0,18,18">
                        <TextBlock Text="26H2 Beta" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.5" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Content Panel (Col 1) ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drag TitleBar and Window Action Button -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                    <Grid>
                        <!-- Top Bar Presets (Visible only when Window Resize card is expanded) -->
                        <StackPanel x:Name="TopPresetsBar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="18,0,0,0" Visibility="Collapsed" RenderTransformOrigin="0,0.5">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScalePresetsBar" ScaleX="0.8" ScaleY="0.8"/>
                                    <TranslateTransform x:Name="TransPresetsBar" X="-10" Y="0"/>
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{DynamicResource SettingsQuickPresets}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource PresetCompact}" Style="{StaticResource OutlineBtn}" FontSize="10.5" Height="26" Padding="10,0" Margin="0,0,4,0" Click="PresetCompact_Click"/>
                            <Button Content="{DynamicResource PresetDefault}" Style="{StaticResource OutlineBtn}" FontSize="10.5" Height="26" Padding="10,0" Margin="0,0,4,0" Click="PresetDefault_Click"/>
                            <Button Content="{DynamicResource PresetMedium}" Style="{StaticResource OutlineBtn}" FontSize="10.5" Height="26" Padding="10,0" Margin="0,0,4,0" Click="PresetMedium_Click"/>
                            <Button Content="{DynamicResource PresetLarge}" Style="{StaticResource OutlineBtn}" FontSize="10.5" Height="26" Padding="10,0" Click="PresetLarge_Click"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource IconBtn}"
                                Foreground="{DynamicResource ErrorRed}"
                                Width="32" Height="32" Margin="0,0,12,0"
                                Click="Cancel_Click">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Scrollable Tabs Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="18,0,18,6">
                    <Grid Margin="0,0,0,8">

                        <!-- ── General Tab ── -->
                        <StackPanel x:Name="PanelGeneral">
                            <!-- Appearance Section -->
                            <TextBlock Text="{DynamicResource SettingsAppearance}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,8,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Language -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SettingsLanguage}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Set default display language for UI text" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="SBtnLangPill" HorizontalAlignment="Right" Click="SLangPill_Click" Style="{StaticResource IconBtn}" ToolTip="Select Language" Padding="0">
                                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="8" Padding="7,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="STxtCurrentLang" Text="DE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                        <Border Width="1" Height="10" Background="{DynamicResource BorderSub}" Margin="6,0"/>
                                                        <TextBlock Text=">>" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <!-- Always on top -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="{DynamicResource SettingsAlwaysOnTop}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Keep the ReelsConverter window on top of other windows" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Behavior Section -->
                            <TextBlock Text="{DynamicResource SettingsBehavior}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Auto-paste -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Auto-Paste Clipboard" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsAutoPaste}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoPaste" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Auto-fetch -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Auto-Fetch Metadata" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsAutoFetch}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoFetch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Notify on complete -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                                                <TextBlock Text="Completion Notification" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsNotifyComplete}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbCompletionNotificationMode" HorizontalAlignment="Right" VerticalAlignment="Center" Width="170" SelectedIndex="2">
                                                <ComboBoxItem Content="Off" Tag="off"/>
                                                <ComboBoxItem Content="Notification Only" Tag="notification_only"/>
                                                <ComboBoxItem Content="Sound &amp; Notification" Tag="sound_and_notification"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Window Resize Tab ── -->
                        <StackPanel x:Name="PanelWindowSizes" Visibility="Collapsed">
                            <!-- Main Window Resize Card (Collapsible) -->
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,4,0,16" Padding="14,12">
                                <StackPanel>
                                    <!-- Clickable Header Row -->
                                    <Grid x:Name="HeaderWindowResize" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="HeaderWindowResize_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
