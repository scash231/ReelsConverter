                                                </StackPanel>
                                                <Slider x:Name="SldWidth" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Minimum="400" Maximum="1600" SmallChange="10" LargeChange="50" ValueChanged="SldWidth_ValueChanged"/>
                                                <TextBox x:Name="TxtWidth" Grid.Column="2" VerticalAlignment="Center" Padding="4,3" TextAlignment="Center" FontSize="11" TextChanged="TxtWidth_TextChanged"/>
                                            </Grid>
                                        </Border>

                                        <!-- Height Controls -->
                                        <Border Padding="0,8" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource SettingsHeightPx}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtHeightLimits" Text="300 - 1200" FontSize="9" Foreground="{DynamicResource TextSec}" Opacity="0.6"/>
                                                </StackPanel>
                                                <Slider x:Name="SldHeight" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Minimum="250" Maximum="1200" SmallChange="10" LargeChange="50" ValueChanged="SldHeight_ValueChanged"/>
                                                <TextBox x:Name="TxtHeight" Grid.Column="2" VerticalAlignment="Center" Padding="4,3" TextAlignment="Center" FontSize="11" TextChanged="TxtHeight_TextChanged"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Section: Corner Resizer Island -->
                            <TextBlock Text="CORNER RESIZE GRIP" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
