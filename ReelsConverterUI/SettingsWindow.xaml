<Window x:Class="ReelsConverterUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="680" Height="500"
        Icon="Icons/Settings.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- ══════ Sidebar Tab Button ══════ -->
        <Style x:Key="SidebarTabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2,8,2"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Hover Background layer -->
                                <Border x:Name="BgHover" CornerRadius="8" Background="#0AFFFFFF" Opacity="0"/>
                                <!-- Active Background layer -->
                                <Border x:Name="BgActive" CornerRadius="8" Background="#15FFFFFF" Opacity="0"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Selected Indicator Bar -->
                                    <Border x:Name="Indicator" Grid.Column="0" Width="3" Height="14" CornerRadius="1.5"
                                            Background="{DynamicResource Accent}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                            
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Margin="12,0,12,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Active/Checked state -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgActive" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgActive" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════ ToggleSwitch (CheckBox) ══════ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="#15FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="10">
                            <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="#E6FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,3,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform/>
                                        <ScaleTransform/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Checked state -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)" 
                                                             To="18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.4">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.82">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)" 
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.4">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" 
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.82">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            
                            <!-- Hover + Checked state -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                            
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Left Sidebar (Col 0) ═══ -->
            <Border Grid.Column="0" Background="#0C000000" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" CornerRadius="16,0,0,16" MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,24,18,16">
                        <TextBlock Text="⚙" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tabs Menu List -->
                    <StackPanel Grid.Row="1" x:Name="TabBar" Margin="0,8,0,0">
                        <RadioButton x:Name="TabGeneral" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabGeneral}" IsChecked="True"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabBackdrops" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabBackdrops}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabUpload" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabUpload}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabDownload" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabDownload}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabAdvanced" Style="{StaticResource SidebarTabBtn}"
                                     Content="{DynamicResource SettingsTabAdvanced}"
                                     GroupName="SettingsTab" Checked="Tab_Changed"/>
                    </StackPanel>

                    <!-- Footer Details -->
                    <StackPanel Grid.Row="2" Margin="18,0,18,18">
                        <TextBlock Text="v3.1" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.5" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Content Panel (Col 1) ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drag TitleBar and Window Action Button -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                    <Grid>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource IconBtn}"
                                Foreground="{DynamicResource ErrorRed}"
                                Width="32" Height="32" Margin="0,0,12,0"
                                Click="Cancel_Click">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Scrollable Tabs Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="18,0,18,6">
                    <Grid Margin="0,0,0,8">

                        <!-- ── General Tab ── -->
                        <StackPanel x:Name="PanelGeneral">
                            <!-- Appearance Section -->
                            <TextBlock Text="{DynamicResource SettingsAppearance}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,8,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Language -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SettingsLanguage}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Set default display language for UI text" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0.5" CornerRadius="6" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="SLangDE" Content="DE" Style="{StaticResource IconBtn}" FontSize="10" FontWeight="SemiBold" Width="32" Height="22" Click="SLangDE_Click"/>
                                                    <Border Width="0.5" Background="#15FFFFFF" Margin="2,3"/>
                                                    <Button x:Name="SLangEN" Content="EN" Style="{StaticResource IconBtn}" FontSize="10" FontWeight="SemiBold" Width="32" Height="22" Click="SLangEN_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- Always on top -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="{DynamicResource SettingsAlwaysOnTop}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Keep the ReelsConverter window on top of other windows" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Behavior Section -->
                            <TextBlock Text="{DynamicResource SettingsBehavior}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Auto-paste -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Auto-Paste Clipboard" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsAutoPaste}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoPaste" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Auto-fetch -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Auto-Fetch Metadata" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsAutoFetch}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoFetch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Notify on complete -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Completion Notification" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsNotifyComplete}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkNotifyComplete" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Auto-show progress window -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="{DynamicResource SettingsAutoShowProgressTitle}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsAutoShowProgressDesc}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoShowProgress" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Hide scrollbars -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="{DynamicResource SettingsHideScrollbarsTitle}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsHideScrollbarsDesc}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkHideScrollbars" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Liquid Glass Tab ── -->
                        <StackPanel x:Name="PanelBackdrops" Visibility="Collapsed">
                            <TextBlock Text="LIQUID GLASS BACKDROPS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,8,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Main Window Blur -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Main Window" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Enable composition blur backdrop for the main window" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBlurMain" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Video Editor Blur -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Video Editor" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Enable composition blur backdrop for the video trimmer &amp; subtitles window" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBlurEditor" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Settings Window Blur -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Settings Menu" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Enable composition blur backdrop for this settings window" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBlurSettings" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Log Viewer Blur -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Log Viewer" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Enable composition blur backdrop for the logs output window" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBlurLog" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Dev Console Blur -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Developer Console" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Enable composition blur backdrop for the command line developer console" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBlurConsole" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Description Editor Blur -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Description Editor" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Enable composition blur backdrop for the metadata text editor popup" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBlurDesc" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Upload Tab ── -->
                        <StackPanel x:Name="PanelUpload" Visibility="Collapsed">
                            <!-- YouTube Section -->
                            <TextBlock Text="{DynamicResource SettingsYoutubeDefaults}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,8,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Default visibility -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                                <TextBlock Text="{DynamicResource SettingsDefaultPrivacy}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Privacy state of newly uploaded videos" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbDefaultPrivacy" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" SelectedIndex="0">
                                                <ComboBoxItem Content="{DynamicResource PrivacyPublic}" Tag="public"/>
                                                <ComboBoxItem Content="{DynamicResource PrivacyUnlisted}" Tag="unlisted"/>
                                                <ComboBoxItem Content="{DynamicResource PrivacyPrivate}" Tag="private"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                    <!-- Auto #Shorts -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Auto #Shorts Tag" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsAutoShorts}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoShorts" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Fingerprint Section -->
                            <TextBlock Text="{DynamicResource SettingsFingerprintBypass}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Enable FP -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Bypass Upload Duplicate Filters" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Modify video headers slightly to prevent duplicate upload flags" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkDefaultFp" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- FP Method -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                                <TextBlock Text="{DynamicResource SettingsFpMethod}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose alteration strength for bypass" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbDefaultFpMethod" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" SelectedIndex="2"
                                                      IsEnabled="{Binding IsChecked, ElementName=ChkDefaultFp}">
                                                <ComboBoxItem Content="{DynamicResource FpMetadata}" Tag="metadata"/>
                                                <ComboBoxItem Content="{DynamicResource FpLight}" Tag="light"/>
                                                <ComboBoxItem Content="{DynamicResource FpStandard}" Tag="standard"/>
                                                <ComboBoxItem Content="{DynamicResource FpStrong}" Tag="strong"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Download Tab ── -->
                        <StackPanel x:Name="PanelDownload" Visibility="Collapsed">
                            <!-- Save Location Section -->
                            <TextBlock Text="{DynamicResource SettingsSaveLocation}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,8,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <Border Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,8">
                                            <TextBlock Text="{DynamicResource SettingsDefaultOutputDir}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Folder where converted reels are saved" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtDefaultOutputDir" Grid.Row="1" Grid.Column="0" IsReadOnly="True" VerticalAlignment="Center" Padding="8,6"/>
                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource OutlineBtn}" Content="{DynamicResource BtnBrowse}" Height="30" Margin="8,0,0,0" Padding="12,0" Click="BrowseOutput_Click"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Quality Section -->
                            <TextBlock Text="{DynamicResource SettingsQualitySection}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <Border Padding="14,12">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                            <TextBlock Text="{DynamicResource SettingsVideoQuality}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Target resolution and bitrate quality for conversion" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbVideoQuality" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" SelectedIndex="0">
                                            <ComboBoxItem Content="{DynamicResource QualityBest}" Tag="best"/>
                                            <ComboBoxItem Content="1080p" Tag="1080p"/>
                                            <ComboBoxItem Content="720p" Tag="720p"/>
                                            <ComboBoxItem Content="480p" Tag="480p"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Fingerprint Section -->
                            <TextBlock Text="{DynamicResource SettingsFingerprintBypass}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Enable FP -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Bypass Download Duplicate Filters" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Alter video bitstream slightly to bypass automated checkers" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkDefaultFpDl" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- FP Method -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                                <TextBlock Text="{DynamicResource SettingsFpMethod}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose alteration strength for downloads" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbDefaultFpMethodDl" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" SelectedIndex="2"
                                                      IsEnabled="{Binding IsChecked, ElementName=ChkDefaultFpDl}">
                                                <ComboBoxItem Content="{DynamicResource FpMetadata}" Tag="metadata"/>
                                                <ComboBoxItem Content="{DynamicResource FpLight}" Tag="light"/>
                                                <ComboBoxItem Content="{DynamicResource FpStandard}" Tag="standard"/>
                                                <ComboBoxItem Content="{DynamicResource FpStrong}" Tag="strong"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Advanced Tab ── -->
                        <StackPanel x:Name="PanelAdvanced" Visibility="Collapsed">
                            <!-- Performance Section -->
                            <TextBlock Text="{DynamicResource SettingsPerformance}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,8,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Use GPU -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="GPU Hardware Acceleration" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsUseGpu}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkUseGpu" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Max concurrent jobs -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                                <TextBlock Text="{DynamicResource SettingsMaxJobs}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Limit simultaneous downloads and uploads" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbMaxJobs" HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" SelectedIndex="0">
                                                <ComboBoxItem Content="1" Tag="1"/>
                                                <ComboBoxItem Content="2" Tag="2"/>
                                                <ComboBoxItem Content="3" Tag="3"/>
                                                <ComboBoxItem Content="4" Tag="4"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Backend Section -->
                            <TextBlock Text="{DynamicResource SettingsBackend}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Backend URL -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SettingsBackendUrl}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Connection URL for the converter API service" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,8"/>
                                            <TextBox x:Name="TxtBackendUrl" Padding="8,6"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Startup timeout -->
                                    <Border Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SettingsBackendTimeout}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Max seconds to wait for backend to initialize on startup" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,8"/>
                                            <TextBox x:Name="TxtBackendTimeout" Padding="8,6"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Developer Section -->
                            <TextBlock Text="{DynamicResource SettingsDeveloper}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Dev console -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Developer Logging Console" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsDevConsole}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkDevConsole" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Reset button -->
                            <Button Style="{StaticResource OutlineBtn}"
                                    Content="{DynamicResource SettingsResetAll}"
                                    Foreground="{DynamicResource ErrorRed}"
                                    BorderBrush="#30FF0000"
                                    HorizontalAlignment="Left" Margin="4,2,0,12" Height="32" Padding="14,0"
                                    Click="ResetAll_Click"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <!-- Footer (Row 2) -->
                <Border Grid.Row="2" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Margin="0,4,0,0">
                    <Grid Margin="18,12,18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Content="{DynamicResource BtnCancelSettings}"
                                Style="{StaticResource OutlineBtn}"
                                Margin="0,0,8,0" Height="32" Padding="14,0"
                                Click="Cancel_Click"/>
                        <Button Grid.Column="2"
                                Content="{DynamicResource BtnSaveSettings}"
                                Style="{StaticResource GradRectBtn}" Width="100" Height="32"
                                Click="Save_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
