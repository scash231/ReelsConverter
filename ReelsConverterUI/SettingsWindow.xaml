                            <TextBlock Text="CONSOLE PREFERENCES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <Border Padding="14,14">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                            <TextBlock Text="Developer Logging Console" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SettingsDevConsole}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkDevConsole" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Console Filters Section -->
                            <TextBlock Text="{DynamicResource SettingsConsoleFilters}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Show System Events -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="{DynamicResource SettingsConsoleShowSystem}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsConsoleShowSystemDesc}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkConsoleShowSystem" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Show Backend Events -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="{DynamicResource SettingsConsoleShowBackend}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsConsoleShowBackendDesc}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkConsoleShowBackend" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Show FFmpeg Events -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="{DynamicResource SettingsConsoleShowFFmpeg}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource SettingsConsoleShowFFmpegDesc}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkConsoleShowFFmpeg" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Backend Tab ── -->
                        <StackPanel x:Name="PanelBackend" Visibility="Collapsed">
                            <!-- Header Setting: Auto-Restart Backend Daemon -->
                            <TextBlock Text="BACKEND SERVICE PREFERENCES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <Border Padding="14,14">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                            <TextBlock Text="Auto-Restart Backend Daemon" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Automatically restart the converter backend process if it crashes or disconnects." FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoRestartBackend" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Backend Configuration Section -->
                            <TextBlock Text="SERVICE PARAMETERS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="4,4,4,8"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0.5" CornerRadius="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Backend Service URL -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SettingsBackendUrl}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Connection URL for the converter API service" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,8"/>
                                            <TextBox x:Name="TxtBackendUrl" Padding="8,6"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Connection Timeout -->
                                    <Border Padding="14,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SettingsBackendTimeout}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Max seconds to wait for backend to initialize on startup" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,8"/>
                                            <TextBox x:Name="TxtBackendTimeout" Padding="8,6"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log Level -->
                                    <Border Padding="14,12">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                                <TextBlock Text="Daemon Log Verbosity" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Set internal log output detail for the backend engine process" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbBackendLogLevel" Width="120" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Info" Tag="info"/>
                                                <ComboBoxItem Content="Debug" Tag="debug"/>
                                                <ComboBoxItem Content="Verbose" Tag="verbose"/>
                                                <ComboBoxItem Content="Warning" Tag="warning"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Backend Actions -->
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,16">
                                <Button Style="{StaticResource OutlineBtn}"
                                        Content="Test Backend Connection"
                                        Height="30" Padding="14,0"
                                        Click="TestBackendConnection_Click"/>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <!-- Action Buttons Footer -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,1,0,0" Margin="0,4,0,0">
                    <Grid Margin="18,12,18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Left-aligned Reset Window Sizes Button (Visible ONLY on Window Resize tab) -->
                        <Button x:Name="BtnResetWindowSizes" Grid.Column="0"
                                Content="{DynamicResource BtnResetWindowSizes}"
                                Style="{StaticResource OutlineBtn}"
                                Foreground="{DynamicResource Accent}"
                                BorderBrush="#30007ACC"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Height="32" Padding="14,0"
                                Visibility="Collapsed"
                                Click="ResetWindowSizes_Click"/>
                        <Button Grid.Column="1"
                                Content="{DynamicResource BtnCancelSettings}"
                                Style="{StaticResource OutlineBtn}"
                                Margin="0,0,8,0" Height="32" Padding="14,0"
                                Click="Cancel_Click"/>
                        <Button x:Name="BtnSaveOnly" Grid.Column="2"
                                Content="{DynamicResource BtnSaveOnly}"
                                Style="{StaticResource OutlineBtn}"
                                Margin="0,0,8,0" Height="32" Padding="16,0"
                                Click="SaveOnly_Click"/>
                        <Button Grid.Column="3"
                                Content="{DynamicResource BtnSaveAndExit}"
                                Style="{StaticResource GradRectBtn}" Height="32" Padding="16,0"
                                Click="SaveAndExit_Click"/>
                    </Grid>
                </Border>
            </Grid>
            <!-- ═══════════ LANGUAGE SELECTOR POPUP ═══════════ -->
            <Popup x:Name="SLangPopup" PlacementTarget="{Binding ElementName=SBtnLangPill}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                   PopupAnimation="None" Closed="SLangPopup_Closed">
                <Border x:Name="SLangPopupBorder"
                        Background="{DynamicResource PopupBg}"
                        BorderBrush="{DynamicResource BorderSub}"
                        BorderThickness="0.5" CornerRadius="12"
                        Padding="4,6" Margin="0,4,0,0" MinWidth="135"
                        RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform Y="-6"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="Black" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectSLang_Click" Tag="de">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇩🇪" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Deutsch" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="SCheckLangDE" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectSLang_Click" Tag="en">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇬🇧" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="English" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="SCheckLangEN" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectSLang_Click" Tag="es">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇪🇸" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Español" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="SCheckLangES" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectSLang_Click" Tag="fr">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇫🇷" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Français" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="SCheckLangFR" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectSLang_Click" Tag="it">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇮🇹" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Italiano" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="SCheckLangIT" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectSLang_Click" Tag="ja">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇯🇵" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="日本語" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="SCheckLangJA" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectSLang_Click" Tag="zh">
                            <Grid Width="110">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇨🇳" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="中文" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="✓" x:Name="SCheckLangZH" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="22" Height="22" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    ToolTip="Drag to resize window"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style quarter-circle resize indicator -->
                <Viewbox>
                    <Grid Width="24" Height="24">
                <!-- Concave arc: opens toward window interior (iPadOS corner grip) -->
                <Path Data="M 0,22 A 22,22 0 0,0 22,0"
                      Stroke="{DynamicResource TextSec}"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.6"
                      Fill="Transparent"/>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</Window>
