                                                                                    <Border Grid.Column="1" Background="#27C93F" CornerRadius="1" Height="5" Width="15"><TextBlock Text="OK" FontSize="3.5" Foreground="#FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                                                    <TextBlock Grid.Column="2" Text="Task success" FontSize="4" Foreground="#FFF" Margin="2,0,0,0"/>
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>

