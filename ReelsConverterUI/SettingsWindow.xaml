                                                                    MouseLeftButtonUp="PreviewResizeHandle_MouseUp">
                                                                <Path Data="M 14,6 L 6,14 M 14,10 L 10,14 M 14,14 L 14,14" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85" Margin="3"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Width Controls -->
                                        <Border Padding="0,8" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,0.5">
