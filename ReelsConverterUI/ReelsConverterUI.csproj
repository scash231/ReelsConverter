<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<RootNamespace>ReelsConverterUI</RootNamespace>
		<AssemblyName>ReelsConverterUI</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>..\Icons\app.ico</ApplicationIcon>
		<StartupObject>ReelsConverterUI.Program</StartupObject>
	</PropertyGroup>

	<!-- Nur beim dotnet publish aktiv -->
	<PropertyGroup Condition="'$(PublishProtocol)' != '' or '$(Publish)' == 'true'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="..\Icons\app.ico" Link="Icons\app.ico" />
		<Resource Include="..\Icons\DescritpionEditor.ico" Link="Icons\DescritpionEditor.ico" />
		<Resource Include="..\Icons\DesignerWindow.ico" Link="Icons\DesignerWindow.ico" />
		<Resource Include="..\Icons\Editor.ico" Link="Icons\Editor.ico" />
		<Resource Include="..\Icons\ProgressWindow.ico" Link="Icons\ProgressWindow.ico" />
		<Resource Include="..\Icons\Settings.ico" Link="Icons\Settings.ico" />
	</ItemGroup>

	<!-- Backend-Ordner neben die .exe kopieren -->
	<ItemGroup>
		<None Include="backend\**\*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>