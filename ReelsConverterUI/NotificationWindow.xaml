<Window x:Class="ReelsConverterUI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Width="360" Height="120"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" SizeToContent="Height">

    <Grid x:Name="RootGrid" Margin="12">
        <Border x:Name="NotificationBorder" CornerRadius="14"
                Background="#D51C1C22"
                BorderBrush="#25FFFFFF" BorderThickness="1"
                RenderTransformOrigin="0.5,0.0"
                Cursor="Hand" MouseLeftButtonDown="Notification_Click">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WindowScale" ScaleX="0.9" ScaleY="0.9"/>
                    <TranslateTransform x:Name="WindowTranslate" Y="-20"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.45"/>
            </Border.Effect>
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <TextBlock x:Name="TxtIcon" Text="⚠" FontSize="18" Margin="0,0,12,0"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                
                <!-- Message text -->
                <TextBlock x:Name="TxtMessage" Grid.Column="1" Text="Notification message..."
                           Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="16"/>
                
                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Margin="8,0,0,0"
                        Width="22" Height="22" Click="Close_Click" VerticalAlignment="Center"
                        ToolTip="Close">
                    <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource TextSec}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
