<Window x:Class="ReelsConverterUI.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Log" Width="500" Height="360"
        WindowStyle="None" AllowsTransparency="True"
        Icon="Icons/app.ico"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WinScale"/>
                <TranslateTransform x:Name="WinTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgDeep}" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="🗒 Job Log" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource ErrorRed}"
                            Width="30" Height="30"
                            HorizontalAlignment="Right" Margin="0,0,4,0"
                            Click="Close_Click">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Log TextBox -->
            <TextBox x:Name="TxtLog" Grid.Row="1"
                     Margin="12,10,12,0"
                     Background="{DynamicResource BgDeep}"
                     BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
                     Foreground="#7A9EC0"
                     FontFamily="Consolas"
                     FontSize="10"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="8,6"/>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="12,8,12,12">
                <Button Content="📋 Kopieren" Style="{StaticResource OutlineBtn}"
                        HorizontalAlignment="Left"
                        Click="Copy_Click"/>
                <Button Content="Schließen" Style="{StaticResource OutlineBtn}"
                        HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>
            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="22" Height="22" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    ToolTip="Drag to resize window"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style quarter-circle resize indicator -->
                <Viewbox>
                    <Grid Width="24" Height="24">
                <!-- Concave arc: opens toward window interior (iPadOS corner grip) -->
                <Path Data="M 0,22 A 22,22 0 0,0 22,0"
                      Stroke="{DynamicResource TextSec}"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.6"
                      Fill="Transparent"/>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</Window>


